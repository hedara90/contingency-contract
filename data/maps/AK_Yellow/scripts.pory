mapscripts AK_Yellow_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: AKYellow_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_5, 0: AKYellow_Setup
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_5, 0: AKYellow_OnGauntletStart
    ]
}

const player = OBJ_EVENT_ID_PLAYER
const tiana = LOCALID_TIANA

script AKYellow_OnTransition {
    if(var(VAR_GAUNTLET_POSITION)==0){
        setobjectxyperm(tiana, 10, 11)
    }
}

script AKYellow_Setup {
    hideobjectat(player, MAP_AK_YELLOW)
}

script AKYellow_OnGauntletStart {
    setvar(VAR_TEMP_5, 1)
    call(Gauntlet_SetupCamera)
    goto(AKYellow_StartBattle)
}

script AKYellow_StartBattle {
    switch(var(VAR_GAUNTLET_POSITION)) {
        case 0: 
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(AKYellow_Shu)
            call(Gauntlet_PostBattle)
            goto(AKYellow_StartBattle)
        case 1:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(AKYellow_Nian)
            call(Gauntlet_PostBattle)
            goto(AKYellow_StartBattle)
        case 2:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(AKYellow_Elysium)
            call(Gauntlet_PostBattle)
            goto(AKYellow_StartBattle)
        case 3:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(AKYellow_Irene)
            call(AKYellow_WonGauntlet)
    }
}

script AKYellow_WonGauntlet {
    call(Gauntlet_AfterGauntletWin)
    victoryscreen(GAUNTLET_AK_YELLOW, FALSE)
    waitstate
    call(Gauntlet_WarpOutAfterWin)
}

script AKYellow_Shu {
    msgbox(ShuBeforeBattle)
    trainerbattle_no_intro(TRAINER_SHU, ShuAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(ShuAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(ShuAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text ShuBeforeBattle {
    "Who am I? The answer lies only in\n"
    "all that I've seen. The same way\p"
    "seeds are inanimate, and yet they\n"
    "germinate after you put them in the\p"
    "ground. You wonder what it's like?\n"
    "Hehe, take a deep breath and\l"
    "you've more or less felt it."
}

text ShuAfterBattle {
    "Spring breeze, timely rain; now we\n"
    "sow the grain."
}

text ShuAfterBattle_Win {
    "A day of fine sun and gentle breeze.\n"
    "I hope everyone makes it home\l"
    "safe."
}

text ShuAfterBattle_Lose {
    "All life requires both sunlight and\n"
    "water to grow. I don't think\p"
    "you've had your ten cups of water\n"
    "yet today."
}

script AKYellow_Nian {
    msgbox(NianBeforeBattle)
    trainerbattle_no_intro(TRAINER_NIAN, NianAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(NianAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(NianAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text NianBeforeBattle {
    "That lame look of yours is grinding\n"
    "my gears… Here, have a battle\l"
    "to lighten up!"
}

text NianAfterBattle {
    "Maaan, I'm so hungry…"
}

text NianAfterBattle_Win {
    "I used to just focus myself on what\n"
    "I needed for daily life, but I'm\p"
    "the type to really absorb my\n"
    "surroundings. And somehow or other\p"
    "I keep getting into fights. This was\n"
    "a great one, though!"
}

text NianAfterBattle_Lose {
    "If you're out of touch with reality,\n"
    "you'll end up crushed beneath its\l"
    "boot, sooner or later."
}

script AKYellow_Elysium {
    msgbox(ElysiumBeforeBattle)
    trainerbattle_no_intro(TRAINER_ELYSIUM, ElysiumAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(ElysiumAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(ElysiumAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text ElysiumBeforeBattle {
    "Lost? No worries, tell me where you\n"
    "wanna go."
}

text ElysiumAfterBattle {
    "There's no overstating the importance\n"
    "of communication when battling."
}

text ElysiumAfterBattle_Win {
    "Why does everyone prefer looking at\n"
    "a map over asking me for\p"
    "directions? The captain says my\n"
    "glib tone gets on people's nerves.\p"
    "But that can't be, I always treat\n"
    "everyone with perfect kindness!"
}

text ElysiumAfterBattle_Lose {
    "On the battlefield, few things are\n"
    "more important than morale."
}

script AKYellow_Irene {
    msgbox(IreneBeforeBattle)
    trainerbattle_no_intro(TRAINER_IRENE, IreneAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(IreneAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(IreneAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text IreneBeforeBattle {
    "Hm… Are these all your operators? Is\n"
    "it just me or do some of them seem\p"
    "like an actual security risk?\n"
    "Alright, fine. I will try my best to\l"
    "focus on their combat techniques…"
}

text IreneAfterBattle {
    "Keep an eye out for the\n"
    "tides and mist."
}

text IreneAfterBattle_Win {
    "I have to get back to my handcannon\n"
    "practice once I'm done with my work\p"
    "here. Good luck in the battles\n"
    "ahead!"
}

text IreneAfterBattle_Lose {
    "The scriptures tell us the light of\n"
    "an Inquisitor's lantern is the light\p"
    "of faith within our hearts. When an\n"
    "Inquisitor lays down judgment, her\p"
    "ruling should be based not on law,\n"
    "but instead her own heart."
}

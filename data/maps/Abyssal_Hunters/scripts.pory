mapscripts Abyssal_Hunters_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: AbyssalHunters_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_GAUNTLETHANDLING, 0: AbyssalHunters_Setup
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_GAUNTLETHANDLING, 0: AbyssalHunters_OnGauntletStart
        VAR_GAUNTLETHANDLING, 1: AbyssalHunters_OnSaveResume
    ]
    MAP_SCRIPT_ON_RESUME {
        callnative(SpectatorVObjects)
    }
}

const player = OBJ_EVENT_ID_PLAYER
const tiana = LOCALID_TIANA

script AbyssalHunters_OnTransition {
    if(var(VAR_GAUNTLET_POSITION)==0){
        setobjectxyperm(tiana, 10, 11)
    }
}

script AbyssalHunters_Setup {
    hideobjectat(player, MAP_ABYSSAL_HUNTERS)
}

script AbyssalHunters_OnGauntletStart {
    setvar(VAR_GAUNTLETHANDLING, 1)
    call(Gauntlet_SetupCamera)
    goto(AbyssalHunters_StartBattle)
}

script AbyssalHunters_OnSaveResume {
    call(Gauntlet_ResumeSave)
    goto(AbyssalHunters_StartBattle)
}

script AbyssalHunters_StartBattle {
    switch(var(VAR_GAUNTLET_POSITION)) {
        case 0: 
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(AbyssalHunters_Specter)
            call(Gauntlet_PostBattle)
            goto(AbyssalHunters_StartBattle)
        case 1:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(AbyssalHunters_Gladiia)
            call(Gauntlet_PostBattle)
            goto(AbyssalHunters_StartBattle)
        case 2:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(AbyssalHunters_Skadi)
            call(Gauntlet_PostBattle)
            goto(AbyssalHunters_StartBattle)
        case 3:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(AbyssalHunters_Ulpianus)
            goto(AbyssalHunters_WonGauntlet)
    }
}

script AbyssalHunters_WonGauntlet {
    call(Gauntlet_AfterGauntletWin)
    victoryscreen(GAUNTLET_ABYSSAL_HUNTERS, FALSE)
    waitstate
    call(Gauntlet_WarpOutAfterWin)
}


script AbyssalHunters_Specter {
    setspeaker(SP_NAME_SPECTER)
    msgbox(SpecterBeforeBattle)
    trainerbattle_no_intro(TRAINER_SPECTER, SpecterAfterBattle)
    // msgbox("Good battle!")
    closemessage
    setspeaker(SP_NAME_SPECTER)
    switch(var(VAR_RESULT)){
        default:
            msgbox(SpecterAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(SpecterAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    closemessage
    return
}

text SpecterBeforeBattle {
    "Ehehehe…\n"
    "Hahahah…\l"
    "AHHAHAHAHAH!"
}

text SpecterAfterBattle {
    "O benevolent Herald, hear my prayer:\n"
    "watch over my dreams and my soul…"
}

text SpecterAfterBattle_Win {
    "Good day. Please allow me a moment\n"
    "of prayer… before I resume my work\l"
    "for the day…"
}

text SpecterAfterBattle_Lose {
    "Hehehe… Cutting things… cutting\n"
    "things is such fun…"
}

script AbyssalHunters_Gladiia {
    setspeaker(SP_NAME_GLADIIA)
    msgbox(GladiiaBeforeBattle)
    trainerbattle_no_intro(TRAINER_GLADIIA, GladiiaAfterBattle)
    // msgbox("Good battle!")
    closemessage
    setspeaker(SP_NAME_GLADIIA)
    switch(var(VAR_RESULT)){
        default:
        if(var(VAR_GLADIIA) < 2){
            addvar(VAR_GLADIIA, 1)
        }
            msgbox(GladiiaAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
        if(var(VAR_GLADIIA) < 3 ){
            addvar(VAR_GLADIIA, 1)
        }
            msgbox(GladiiaAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    closemessage
    return
}

text GladiiaBeforeBattle {
    "Any disruption during my work hours\n"
    "is not permitted. Should there be\l"
    "any offense, I appreciate your\l"
    "understanding."
}

text GladiiaAfterBattle {
    "The air here is dry. Fighting on land\n"
    "sometimes feels sweltering."
}

text GladiiaAfterBattle_Win {
    "The language I use is overly\n"
    "polite…?\p"
    "Hm, I'm still getting\l"
    "acquainted with the language used\l"
    "on the land. Besides, it's in my\l"
    "best interest to be seen as polite."
}

text GladiiaAfterBattle_Lose {
    "Please inform your operators to\n"
    "avoid any physical contact with me\l"
    "or my weapon after a battle.\p"
    "Intense exercise raises my surface\n"
    "temperature. If someone were to\l"
    "complain about being scalded, I\l"
    "would hate to feel guilty."
}

script AbyssalHunters_Skadi {
    msgbox(SkadiBeforeBattle)
    setspeaker(SP_NAME_SKADI)
    trainerbattle_no_intro(TRAINER_SKADI, SkadiAfterBattle)
    // msgbox("Good battle!")
    closemessage
    setspeaker(SP_NAME_SKADI)
    switch(var(VAR_RESULT)){
        default:
            msgbox(SkadiAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(SkadiAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    closemessage
    return
}

text SkadiBeforeBattle {
    "I advise you to keep at least two\n"
    "meters away from me, for your own\l"
    "good. And of course you shouldn't\l"
    "speak to me either…\p"
    "I don't want you to be the next\n"
    "victim of what's after me."
}

text SkadiAfterBattle {
    "So this is how you fight.\n"
    "Very good, I'll keep it in mind."
}

text SkadiAfterBattle_Win {
    "You just don't know when to give up,\n"
    "do you? Alright, so be it. Good\l"
    "luck in the trials ahead."
}

text SkadiAfterBattle_Lose {
    "Compared to the calamities I fought\n"
    "against, you are barely a threat."
}

script AbyssalHunters_Ulpianus {
    setspeaker(SP_NAME_ULPIANUS)
    msgbox(UlpianusBeforeBattle)
    trainerbattle_no_intro(TRAINER_ULPIANUS, UlpianusAfterBattle)
    // msgbox("Good battle!")
    closemessage
    setspeaker(SP_NAME_ULPIANUS)
    switch(var(VAR_RESULT)){
        default:
            msgbox(UlpianusAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(UlpianusAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    closemessage
    return
}

text UlpianusBeforeBattle {
    "The Hunters will lose awareness if\n"
    "deprived of water, but they need\l"
    "only return to the sea to awaken\n"
    "their past.\p"
    "How about you? What opportunity\n"
    "would you need?"
}

text UlpianusAfterBattle {
    "You are dreaming. Which part of\n"
    "yourself do you speak to?"
}

text UlpianusAfterBattle_Win {
    "You will obtain the result that you\n"
    "seek. I have faith."
}

text UlpianusAfterBattle_Lose {
    "You must think carefully on what you\n"
    "base your battle plans upon."
}

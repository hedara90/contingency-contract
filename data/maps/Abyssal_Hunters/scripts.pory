mapscripts Abyssal_Hunters_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: AbyssalHunters_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_5, 0: AbyssalHunters_Setup
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_5, 0: AbyssalHunters_OnGauntletStart
    ]
}

const player = OBJ_EVENT_ID_PLAYER
const tiana = LOCALID_TIANA

script AbyssalHunters_OnTransition {
    if(var(VAR_GAUNTLET_POSITION)==0){
        setobjectxyperm(tiana, 10, 11)
    }
}

script AbyssalHunters_Setup {
    hideobjectat(player, MAP_ABYSSAL_HUNTERS)
}

script AbyssalHunters_OnGauntletStart {
    setvar(VAR_TEMP_5, 1)
    call(Gauntlet_SetupCamera)
    goto(AbyssalHunters_StartBattle)
}

script AbyssalHunters_StartBattle {
    switch(var(VAR_GAUNTLET_POSITION)) {
        case 0: 
            call(Gauntlet_OpponentMovement_BeforeBattle)
            call(AbyssalHunters_Specter)
            call(Gauntlet_PostBattle)
            goto(AbyssalHunters_StartBattle)
        case 1:
            call(Gauntlet_OpponentMovement_BeforeBattle)
            call(Gauntlet_MovePlayerBeforeBattle)
            call(AbyssalHunters_Gladiia)
            call(Gauntlet_PostBattle)
            goto(AbyssalHunters_StartBattle)
        case 2:
            call(Gauntlet_OpponentMovement_BeforeBattle)
            call(Gauntlet_MovePlayerBeforeBattle)
            call(AbyssalHunters_Skadi)
            call(Gauntlet_PostBattle)
            goto(AbyssalHunters_StartBattle)
        case 3:
            call(Gauntlet_OpponentMovement_BeforeBattle)
            call(Gauntlet_MovePlayerBeforeBattle)
            call(AbyssalHunters_Ulpianus)
            call(Gauntlet_PostBattle)
    }
}

script AbyssalHunters_Specter {
    msgbox(SpecterBeforeBattle)
    trainerbattle_no_intro(TRAINER_SPECTER, SpecterAfterBattle)
    // msgbox("Good battle!")
    closemessage
    if(var(VAR_RESULT)==1){
        msgbox(SpecterAfterBattle_Lose)
    }
    else {
        msgbox(SpecterAfterBattle_Win)
    }
    return
}

text SpecterBeforeBattle {
    "Hello"
}

text SpecterAfterBattle {
    ""
}

text SpecterAfterBattle_Win {
    ""
}

text SpecterAfterBattle_Lose {
    ""
}


mapscripts Reconveners_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Reconveners_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_5, 0: Reconveners_Setup
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_5, 0: Reconveners_OnGauntletStart
    ]
    MAP_SCRIPT_ON_RESUME {
        callnative(SpectatorVObjects)
    }
}

const player = OBJ_EVENT_ID_PLAYER
const tiana = LOCALID_TIANA

script Reconveners_OnTransition {
    if(var(VAR_GAUNTLET_POSITION)==0){
        setobjectxyperm(tiana, 10, 11)
    }
}

script Reconveners_Setup {
    hideobjectat(player, MAP_RECONVENERS)
}

script Reconveners_OnGauntletStart {
    setvar(VAR_TEMP_5, 1)
    call(Gauntlet_SetupCamera)
    goto(Reconveners_StartBattle)
}

script Reconveners_StartBattle {
    switch(var(VAR_GAUNTLET_POSITION)) {
        case 0: 
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(Reconveners_Ardelia)
            call(Gauntlet_PostBattle)
            goto(Reconveners_StartBattle)
        case 1:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(Reconveners_Pogranichnik)
            call(Gauntlet_PostBattle)
            goto(Reconveners_StartBattle)
        case 2:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(Reconveners_Gilberta)
            call(Gauntlet_PostBattle)
            goto(Reconveners_StartBattle)
        case 3:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(Reconveners_Laevatain)
            call(Reconveners_WonGauntlet)
    }
}

script Reconveners_WonGauntlet {
    call(Gauntlet_AfterGauntletWin)
    victoryscreen(GAUNTLET_RECONVENERS, FALSE)
    waitstate
    call(Gauntlet_WarpOutAfterWin)
}

script Reconveners_Ardelia {
    msgbox(ArdeliaBeforeBattle)
    trainerbattle_no_intro(TRAINER_ARDELIA, ArdeliaAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(ArdeliaAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(ArdeliaAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text ArdeliaBeforeBattle {
    "Could you stand back a little\n"
    "further? I, uh… I don't want you\l"
    "to get hurt by accident.\p"
    "Let's go, Mr. Dolly!"
}

text ArdeliaAfterBattle {
    "Do you ever find yourself counting\n"
    "sheep before bed? I sure do."
}

text ArdeliaAfterBattle_Win {
    "My diary is like the rings of an\n"
    "ancient tree. It keeps a record of\l"
    "every lesson I learned growing up.\p"
    "Time to add a new page!"
}

text ArdeliaAfterBattle_Lose {
    "Losing isn't the end of the world.\n"
    "Learn from the experience and I'm\l"
    "sure you'll do better next time."
}

script Reconveners_Pogranichnik {
    msgbox(PogranichnikBeforeBattle)
    trainerbattle_no_intro(TRAINER_POG, PogranichnikAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(PogranichnikAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(PogranichnikAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text PogranichnikBeforeBattle {
    "One must learn to wield violence-\n"
    "not for good nor malice, but for\l"
    "the sake of survival."
}

text PogranichnikAfterBattle {
    "A valuable battle… my fighting\n"
    "spirit has been stirred."
}

text PogranichnikAfterBattle_Win {
    "Every victory bears its price… Hold\n"
    "dear what you've learned, but don't\l"
    "forget what we've paid.\p"
    "Also, here. Have a candy. They're\n"
    "good for the soul."
}

text PogranichnikAfterBattle_Lose {
    "Remissness and negligence pose the\n"
    "deadliest threat on the\l"
    "battlefield."
}

script Reconveners_Gilberta {
    msgbox(GilbertaBeforeBattle)
    trainerbattle_no_intro(TRAINER_GILBERTA, GilbertaAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(GilbertaAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(GilbertaAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text GilbertaBeforeBattle {
    "Lovely to see so many new faces on\n"
    "the road! Thought I'd take a break\l"
    "between deliveries to see what all\l"
    "the fuss was about.\p"
    "Looks like fun!"
}

text GilbertaAfterBattle {
    "I hope you had fun floating!"
}

text GilbertaAfterBattle_Win {
    "Got a few tips to help you on the\n"
    "road ahead. Broaden your horizons,\l"
    "learn from the experiences… and\l"
    "add a dash of imagination!"
}

text GilbertaAfterBattle_Lose {
    "No matter how hard you try, you\n"
    "can't escape gravity!"
}

script Reconveners_Laevatain {
    msgbox(LaevatainBeforeBattle)
    trainerbattle_no_intro(TRAINER_LAEVATAIN, LaevatainAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(LaevatainAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(LaevatainAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text LaevatainBeforeBattle {
    "I hate trouble, but boredom's worse.\p"
    "Whatever comes next better be\n"
    "memorable."
}

text LaevatainAfterBattle {
    "What a blaze! I won't forget this\n"
    "anytime soon."
}

text LaevatainAfterBattle_Win {
    "Have you seen the ice cream bar\n"
    "yet? Better get there soon, there\l"
    "might not be much left after I'm\l"
    "through with it."
}

text LaevatainAfterBattle_Lose {
    "Cheer up! At least I got through\n"
    "this battle without accidentally\l"
    "burning anything to ash."
}

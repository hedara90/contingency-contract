script PlayStageMusic {
    playbgm(MUS_CREDITS, FALSE)
    setvar(VAR_MUSIC_CHECKER, 1)
}

script PlayNormalMusic {
    playbgm(MUS_CONTEST_LOBBY, FALSE)
    setvar(VAR_MUSIC_CHECKER, 0)
}

script SatsukiTalk {
    setspeaker(SP_NAME_SATSUKI)
    msgbox("Oh, Tiana")
    waitmessage
    return
}

script SatsukiPaying {
    setspeaker(SP_NAME_SATSUKI)
    msgbox("Oh, Tiana")
    waitmessage
    return
}

script LastQueuer {
    lock
    getvobjectgfxtag(0)
    switch(var(VAR_RESULT)) {
    case OBJ_EVENT_GFX_SATSUKI:
        setspeaker(SP_NAME_PLAYER)
        msgbox("Satsuki? Why are you here?")
        turnvobject(0, DIR_NORTH)
        call(SatsukiTalk)
    default:
        turnvobject(0, DIR_NORTH)
        msgbox("I hope this queue goes fast…")
        waitmessage
    }
    turnvobject(0, DIR_SOUTH)
    release
    end
}


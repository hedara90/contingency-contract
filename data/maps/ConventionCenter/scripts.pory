script MonBanners {
    lock
    msgbox("Hello!\pDo you want to try your luck on a banner?")
    dynmultichoice(0, 0, TRUE, 4, FALSE, DYN_MULTICHOICE_CB_NONE,
                    "Indomitability of the Unbreakable Spirit",
                    "Fury of the Earthern Core",
                    "Memories of Months Past",
                    "No, I'm good for now!")
    switch(var(VAR_RESULT)) {
    case 0:
        gachaui(BANNER_INDOMITABILITY_OF_THE_UNBREAKABLE_SPIRIT)
    case 1:
        gachaui(BANNER_FURY_OF_THE_EARTHEN_CORE)
    case 2:
        gachaui(BANNER_MEMORIES_OF_MONTHS_PAST)
    case 3:
        msgbox("Next time then.")
        waitmessage
        release
        end
    }
    waitstate
    msgbox("Hope it went well.")
    waitmessage
    release
    end
}

script ItemBanner {
    lock
    msgbox("Hello!\pDo you want to try your luck on items?\nOr redeem what you want directly?")
    dynmultichoice(0, 0, TRUE, 3, FALSE, DYN_MULTICHOICE_CB_NONE,
                    "I'll try my luck!",
                    "I'll redeem an item.",
                    "Nothing for now.")
    switch(var(VAR_RESULT)) {
    case 0:
        gachaui(BANNER_ITEMS)
    case 1:
        msgbox("Of course, which rarity?\p4-star items cost 16 points,\n5-star 64, and 6-star costs 256")
        callnative(DisplayItemPoints)
        dynmultichoice(0, 0, TRUE, 4, FALSE, DYN_MULTICHOICE_CB_NONE,
                        "4-Star!",
                        "5-Star!",
                        "6-Star!",
                        "Nevermind.")
        switch(var(VAR_RESULT)) {
        case 0:
            callnative(BuildListOf4StarItems)
            setvar(VAR_RESULT, 0)
            dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
            switch(var(VAR_RESULT)) {
            case 0:
                msgbox("See you another time then.")
            case MULTI_B_PRESSED:
                msgbox("See you another time then.")
            default:
                callnative(GiveItemFromPointShop)
                switch(var(VAR_RESULT)) {
                case 0:
                    msgbox("You don't have enough points for that.")
                case 1:
                    msgbox("Here you go!")
                }
            }
            callnative(HideItemPoints)
            waitmessage
            release
            end
        case 1:
            callnative(BuildListOf5StarItems)
            setvar(VAR_RESULT, 0)
            dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
            switch(var(VAR_RESULT)) {
            case 0:
                msgbox("See you another time then.")
            case MULTI_B_PRESSED:
                msgbox("See you another time then.")
            default:
                callnative(GiveItemFromPointShop)
                switch(var(VAR_RESULT)) {
                case 0:
                    msgbox("You don't have enough points for that.")
                case 1:
                    msgbox("Here you go!")
                }
            }
            callnative(HideItemPoints)
            waitmessage
            release
            end
        case 2:
            callnative(BuildListOf5StarItems)
            setvar(VAR_RESULT, 0)
            dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
            switch(var(VAR_RESULT)) {
            case 0:
                msgbox("See you another time then.")
            case MULTI_B_PRESSED:
                msgbox("See you another time then.")
            default:
                callnative(GiveItemFromPointShop)
                switch(var(VAR_RESULT)) {
                case 0:
                    msgbox("You don't have enough points for that.")
                case 1:
                    msgbox("Here you go!")
                }
            }
            callnative(HideItemPoints)
            waitmessage
            release
            end
        default:
            callnative(HideItemPoints)
            msgbox("See you another time!")
            waitmessage
            release
            end
        }
        callnative(HideItemPoints)
    case 2:
        msgbox("Next time then.")
        waitmessage
        release
        end
    }
    waitstate
    msgbox("Hope it went well.")
    waitmessage
    release
    end
}

script ChooseGauntlet {
    lock
    faceplayer
    msgbox("Which gauntlet do you want to fight?")
    dynmultichoice(0, 0, TRUE, 7, FALSE, DYN_MULTICHOICE_CB_NONE,
                    "Crisis Team",
                    "Wuling",
                    "Reconveners",
                    "AK 1",
                    "AK 2",
                    "AK 3",
                    "Not right now")
    getobjectfacingdirection(LOCALID_ATTENDANT_MAIN, VAR_TEMP_1)
    special(HealPlayerParty)
    setvar(VAR_GAUNTLET_POSITION, 0)
    switch(var(VAR_RESULT)) {
    case 0:
        switch(var(VAR_TEMP_1)) {
        case 1:
            warpsilent(MAP_CRISIS_TEAM, 10, 11)
        case 2:
            warpsilent(MAP_CRISIS_TEAM, 10, 11)
        case 3:
            warpsilent(MAP_CRISIS_TEAM, 9, 10)
        case 4:
            warpsilent(MAP_CRISIS_TEAM, 10, 11)
        }
        waitstate
    case 1:
        switch(var(VAR_TEMP_1)) {
        case 1:
            warpsilent(MAP_WULING, 10, 11)
        case 2:
            warpsilent(MAP_WULING, 10, 11)
        case 3:
            warpsilent(MAP_WULING, 9, 10)
        case 4:
            warpsilent(MAP_WULING, 10, 11)
        }
        waitstate
    case 2:
        switch(var(VAR_TEMP_1)) {
        case 1:
            warpsilent(MAP_RECONVENERS, 10, 11)
        case 2:
            warpsilent(MAP_RECONVENERS, 10, 11)
        case 3:
            warpsilent(MAP_RECONVENERS, 9, 10)
        case 4:
            warpsilent(MAP_RECONVENERS, 10, 11)
        }
        waitstate
    case 3:
        switch(var(VAR_TEMP_1)) {
        case 1:
            warpsilent(MAP_ABYSSAL_HUNTERS, 10, 11)
        case 2:
            warpsilent(MAP_ABYSSAL_HUNTERS, 10, 11)
        case 3:
            warpsilent(MAP_ABYSSAL_HUNTERS, 9, 10)
        case 4:
            warpsilent(MAP_ABYSSAL_HUNTERS, 10, 11)
        }
        waitstate
    case 4:
        switch(var(VAR_TEMP_1)) {
        case 1:
            warpsilent(MAP_AK_YELLOW, 10, 11)
        case 2:
            warpsilent(MAP_AK_YELLOW, 10, 11)
        case 3:
            warpsilent(MAP_AK_YELLOW, 9, 10)
        case 4:
            warpsilent(MAP_AK_YELLOW, 10, 11)
        }
        waitstate
    case 5:
        switch(var(VAR_TEMP_1)) {
        case 1:
            warpsilent(MAP_AK_GREEN, 10, 11)
        case 2:
            warpsilent(MAP_AK_GREEN, 10, 11)
        case 3:
            warpsilent(MAP_AK_GREEN, 9, 10)
        case 4:
            warpsilent(MAP_AK_GREEN, 10, 11)
        }
        waitstate
    }
    waitmessage
    release
    end
}

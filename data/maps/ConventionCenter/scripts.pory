    msgbox("Yes, but I play this game, while I don't\nthink you even own a smartphone.\pSo why would you even be here?")
    setspeaker(SP_NAME_SATSUKI)
    msgbox("I don't own one of those devices, no.\pAnd this convention is for a game\nyou say?\pAnyway, I'm here to ensure the integrity\nof the battle arena.")
    applymovement(player, moves(emote_question_mark, delay_16 * 2))
    waitmovement
    setspeaker(SP_NAME_PLAYER)
    msgbox("The battle arena, why?")
    setspeaker(SP_NAME_SATSUKI)
    msgbox("Well, it's a semi-virtual battling system\noperating under different rules than\lusual battles that nevertheless can\laffect the real world.\pSounds familiar, hmm?")
    applymovement(player, moves(face_up, delay_16, emote_exclamation_mark, delay_16 * 3, face_down))
    waitmovement
    setspeaker(SP_NAME_PLAYER)
    msgbox("It's a Bodhai system!\nOr at least something similar!")
    setspeaker(SP_NAME_SATSUKI)
    msgbox("Yes, the setup here uses a derivation\nof the Bodhai system with a strictly\llocal causal interference.")
    setspeaker(SP_NAME_PLAYER)
    msgbox("So I won't wake up tomorrow to a set\nof earthshattering revelations?")
    setspeaker(SP_NAME_SATSUKI)
    msgbox("No, this system is as mentioned strictly\nlocal.")
    applymovement(player, moves(emote_exclamation_mark))
    setspeaker(SP_NAME_PLAYER)
    msgbox("Enough of that!\pThat explains why you're here, but\nwhy are you in this queue?")
    setspeaker(SP_NAME_SATSUKI)
    msgbox("The… what were they called?\pChubby Lungs I think.\pThey are quite cute. So I ordered\na few ahead of time to pick up today.\pI saw the big ones when inspecting\nthe initial setup of the arena.")
    setspeaker(SP_NAME_PLAYER)
    msgbox("Wait, are you the reason Chisa and I\ngot CC Passes?")
    setspeaker(SP_NAME_SATSUKI)
    msgbox("Yes, I got them for helping with the\nsetup, but I had no use for them.\pSo I transferred them to you.")
    applymovement(player, moves(emote_heart))
    setspeaker(SP_NAME_PLAYER)
    msgbox("Have I said that you're the best\nboss ever?")
    setspeaker(SP_NAME_SATSUKI)
    msgbox("I could stand to hear it more.\pBut you should probably go take\nadvantage of it instead of socializing\lwith me.")
    applymovement(player, moves(emote_heart))
    setspeaker(SP_NAME_PLAYER)
    msgbox("I will!\pThank you again!")
    setflag(FLAG_TALKED_SATSUKI)
    return
}

script LastQueuer {
    lock
    getvobjectgfxtag(0)
    switch(var(VAR_RESULT)) {
    case OBJ_EVENT_GFX_SATSUKI:
        setspeaker(SP_NAME_PLAYER)
        msgbox("Satsuki? Why are you here?")
        turnvobject(0, DIR_NORTH)
        call(SatsukiTalk)
    default:
        turnvobject(0, DIR_NORTH)
        msgbox("I hope this queue goes fast…")
        waitmessage
    }
    turnvobject(0, DIR_SOUTH)
    release
    end
}


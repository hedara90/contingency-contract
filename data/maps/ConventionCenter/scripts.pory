mapscripts ConventionCenter_MapScripts {
    MAP_SCRIPT_ON_RESUME {
        if (flag(FLAG_QUEUE_LOADED) == TRUE) {
            callnative(CreateQueue)
        }
        if (flag(FLAG_OTHER_LOADED) == TRUE) {
            callnative(CreateOtherVObjects)
        }
    }
}

const player = OBJ_EVENT_ID_PLAYER

script TryLoadQueue {
    if (flag(FLAG_QUEUE_LOADED) != TRUE) {
        callnative(CreateQueue)
        setflag(FLAG_QUEUE_LOADED)
    }
}

script TryUnloadQueue {
    if (flag(FLAG_QUEUE_LOADED) == TRUE) {
        callnative(DestroyQueue)
        clearflag(FLAG_QUEUE_LOADED)
    }
    if (flag(FLAG_OTHER_LOADED) == TRUE) {
        callnative(DestroyOther)
        clearflag(FLAG_OTHER_LOADED)
    }
}

script TryLoadOther {
    if (flag(FLAG_OTHER_LOADED) != TRUE) {
        callnative(CreateOtherVObjects)
        setflag(FLAG_OTHER_LOADED)
    }
}

script ChubbyLung1 {
    lock
    applymovement(player, ContestHall_Movement_Heart)
    waitmovement
    msgbox("It's a big Chubby Lung!")
    waitmessage
    release
    end
}


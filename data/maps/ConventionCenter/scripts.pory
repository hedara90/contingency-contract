    release
}

const carnelian = LOCALID_CC_CARNELIAN
const elysium = LOCALID_CC_ELYSIUM

script CC_Carnelian {
    lock
    applymovement(carnelian, moves(walk_in_place_up))
    waitmovement
    setspeaker(SP_NAME_CARNELIAN)
    msgbox("What's your favourite Arknights song?\p"
            "I'm a big fan of the Operation Pyrite\ntheme, but the new IS7 boss theme \lis great too.")
    waitmessage
    applymovement(elysium, moves(walk_in_place_down))
    setspeaker(SP_NAME_ELYSIUM)
    msgbox("I want you on your knees...")
    delay(60)
    waitmessage
    applymovement(carnelian, moves(emote_question_mark))
    waitmovement
    setspeaker(SP_NAME_CARNELIAN)
    msgbox("...sorry?")
    waitmessage
    applymovement(elysium, moves(walk_in_place_down))
    setspeaker(SP_NAME_ELYSIUM)
    msgbox("This buried love grows teeth...")
    waitmessage
    setspeaker(SP_NAME_CARNELIAN)
    msgbox("Are these like, some lyrics?")
    waitmessage
    applymovement(elysium, moves(walk_in_place_down))
    setspeaker(SP_NAME_ELYSIUM)
    msgbox("A thousand stars weeping...")
    waitmessage
    delay(60)
    msgbox("Dang, you don't know it?\p"
        "Well, now I look silly, don't I?")
    waitmessage
    applymovement(carnelian, moves(walk_in_place_up))
    setspeaker(SP_NAME_CARNELIAN)
    msgbox("You could've just told me the song name\ninstead of telling me to get on my\lknees!\p"
            "Thats just weird man.")
    closemessage
    applymovement(elysium, moves(face_left, delay_16*5, face_down))
    setspeaker(SP_NAME_ELYSIUM)
    msgbox("Yeah... I can't disagree with that...")
    waitmessage
    applymovement(carnelian, moves(walk_in_place_up))
    setspeaker(SP_NAME_CARNELIAN)
    msgbox("So what is the song name then?")
    waitmessage
    applymovement(elysium, moves(emote_exclamation_mark))
    waitmovement
    setspeaker(SP_NAME_ELYSIUM)
    msgbox("Oh it's Alleikhreos's intro theme.\nAll 4 of them are great!")
    closemessage
    release
}

const satsuki = LOCALID_CC_SATSUKI

script CC_Satsuki {
    lock
    faceplayer
    setspeaker(SP_NAME_SATSUKI)
    msgbox("Hey Tiana. Enjoying yourself?")
    dynmultichoice(0, 0, TRUE, 4, TRUE, DYN_MULTICHOICE_CB_NONE,
            "Yep!")
    setspeaker(SP_NAME_SATSUKI)
    msgbox("That's nice.")
    waitmessage
    applymovement(satsuki, moves(face_down))
    msgbox("I've been observing the battles here.\n"
            "Some interesting strategies I've seen,\lthat's for sure.")
    waitmessage
    applymovement(satsuki, moves(face_player))
    waitmovement
    setspeaker(SP_NAME_SATSUKI)
    msgbox("Also, your friend seems to be having\na good time.")
    applymovement(satsuki, moves(face_player))
    setspeaker(SP_NAME_PLAYER)
    msgbox("Yeah, she's not too shabby at battling.")
    waitmessage
    setspeaker(SP_NAME_SATSUKI)
    msgbox("Mmhm. Perhaps in a different timeline\nshe could've been your colleague.")
    applymovement(player, moves(emote_exclamation_mark))
    playse(SE_PIN)
    waitmovement
    setspeaker(SP_NAME_PLAYER)
    msgbox("Satsuki please, don't mention different\ntimelines on my day off.")
    waitmessage
    applymovement(satsuki, moves(emote_heart))
    setspeaker(SP_NAME_SATSUKI)
    msgbox("Fufufu, alright.\p"
            "When it's time to leave, could you\ncarry some of my Chubby Lungs?\lI'd rather not make two trips.")
    waitmessage
    applymovement(satsuki, moves(face_down))
    setspeaker(SP_NAME_PLAYER)
    delay(60)
    msgbox("...")
    closemessage
    release
}

const weiqiGuy = LOCALID_CC_WEIQIGUY
const weiqiGirl = LOCALID_CC_WEIQIGIRL

script CC_Weiqi {
    lock
    applymovement(weiqiGuy, moves(walk_in_place_right))
    msgbox("They put this weiqi board here, but...\n{PAUSE_UNTIL_PRESS}do you know how to play the game?")
    applymovement(weiqiGirl, moves(emote_question_mark))
    waitmovement
    msgbox("Oh I sure don't, and they didn't provide\nany instructions either.")
    waitmessage
    delay(45)
    applymovement(weiqiGuy, moves(walk_in_place_right))
    msgbox("Hmm...\p"
            "There's black and white stones,\nhow about we just play checkers?")
    closemessage
    release
}

const kenichi = LOCALID_CC_KENICHI

script CC_Kenichi {
    lock
    getobjectcurrentxy(player, CURRENT_POSITION, VAR_TEMP_7, VAR_TEMP_8)
    setspeaker(SP_NAME_PLAYER)
    msgbox("Kenichi? How did you end up here?!")
    waitmessage
    applymovement(kenichi, moves(face_player))
    setspeaker(SP_NAME_KENICHI)
    msgbox("Oh, miss Tiana!\n{PAUSE_UNTIL_PRESS}Fancy seeing you here!")
    closemessage
    applymovement(kenichi, moves(face_down, delay_16*4, face_player))
    setspeaker(SP_NAME_KENICHI)
    msgbox("As you can see I'm in charge of\nthe dancefloor.\p"
            " While I might be primarly a sailor,\nduring my spare time I make music mixes\ltogether with my wife.")
    applymovement(player, moves(emote_exclamation_mark))
    playse(SE_PIN)
    waitmovement
    msgbox("Ohhh, that's so cool!\nSo you make songs together?")
    waitmessage
    setspeaker(SP_NAME_KENICHI)
    msgbox("Nah, we don't produce any songs.\p"
            "it's mostly just remixin' songs\nand making 'em flow together")
    waitmessage
    applymovement(kenichi, moves(face_down))
    msgbox("It's our way of doing things together\neven when we're far apart.")
    waitmessage
    applymovement(kenichi, moves(face_player))
    if(var(VAR_TEMP_7)==14){
        applymovement(player, moves(walk_in_place_right))
    }
    else {
        applymovement(player, moves(walk_in_place_left))
    }
    waitmovement
    setspeaker(SP_NAME_PLAYER)
    msgbox("Is Scilla also here then?")
    closemessage
    setspeaker(SP_NAME_KENICHI)
    msgbox("Nah, she's at home right now.\p"
            "I took the kid with me so she\ncan have some peace and quiet.")
    waitmessage
    applymovement(kenichi, moves(face_down, delay_16*4, face_player))
    waitmovement
    setspeaker(SP_NAME_KENICHI)
    msgbox("Not often that she gets to have some\nalone time.\p"
            "I'm usually out at sea, so she's\ngotta keep Akuwa in check most days.")
    waitmessage
    applymovement(player, moves(emote_heart))
    waitmovement
    setspeaker(SP_NAME_PLAYER)
    msgbox("Aw, that's cute.")
    waitmessage
    applymovement(kenichi, moves(emote_exclamation_mark, face_down, delay_16*4, face_player))
    setspeaker(SP_NAME_KENICHI)
    msgbox("I gotta handle this transition.\nEnjoy the con!")
    applymovement(kenichi, moves(face_down))
    release
}


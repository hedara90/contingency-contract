const guard1 = LOCALID_CC_GUARD1
const guard2 = LOCALID_CC_GUARD2
const guard3 = LOCALID_CC_GUARD3
const gilberta1 = LOCALID_CC_GILBERTA1
const gilberta2 = LOCALID_CC_GILBERTA2
const gilberta3 = LOCALID_CC_GILBERTA3

script CC_GilbertaEntrance {
    if(var(VAR_TEMP_9)==1){
        goto(CC_GilbertaEntrance_After)
    }

mapscripts ConventionCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: CC_OnTransition
    MAP_SCRIPT_ON_RESUME {
        if (flag(FLAG_QUEUE_LOADED) == TRUE) {
            callnative(CreateQueue)
        }
        if (flag(FLAG_OTHER_LOADED) == TRUE) {
            callnative(CreateOtherVObjects)
        }
    }
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_INTRO, 0 : CC_Intro
    ]
}

const player = OBJ_EVENT_ID_PLAYER
const camera = LOCALID_CAMERA
const zhuang = LOCALID_CC_ZHUANG
const nian = LOCALID_CC_NIAN
const shu = LOCALID_CC_SHU
const Event_GilbertaEntrance = FLAG_TEMP_19
const Event_GilbertaBooth = FLAG_TEMP_18
const Event_GilbertaCafe = FLAG_TEMP_17
const chisa = LOCALID_CC_CHISA
const ardelia = LOCALID_CC_ARDELIA
const receptionist = LOCALID_CC_RECEPTIONIST

script CC_OnTransition {
    call(CC_GilbertaEvent)
    call(CC_PickRandomEvents)
    if(var(VAR_INTRO)==0){
        setobjectxyperm(chisa, 7, 22)
    }
    if(flag(FLAG_SATSUKI_QUEUED)== FALSE){
        setflag(FLAG_SATSUKI)
    }
    // hideobjectat(LOCALID_CC_TAIL, MAP_CONVENTION_CENTER)
    setflag(FLAG_TAIL)
}

script CC_GilbertaEvent {
    random(5)
    switch(var(VAR_RESULT)){
        case 0:
            setflag(Event_GilbertaBooth)
            setflag(Event_GilbertaCafe)
        case 1:
            setflag(Event_GilbertaEntrance)
            setflag(Event_GilbertaCafe)
        case 2:
            setflag(Event_GilbertaEntrance)
            setflag(Event_GilbertaBooth)
        default:
            setflag(Event_GilbertaEntrance)
            setflag(Event_GilbertaBooth)
            setflag(Event_GilbertaCafe)
    }
    random(10)
    copyvar(VAR_CHISA_PARTY, VAR_RESULT)
}

script CC_PickRandomEvents {
    //Abyssal Hunters group
    //Gladiia in lounge
    random(2)
    switch(var(VAR_RESULT)){
        case 0: setflag(FLAG_GLADIIA)
        default: clearflag(FLAG_GLADIIA)
    }
    random(2)
    switch(var(VAR_RESULT)){
        case 0: setflag(FLAG_JOHNENDFIELD)
        default: clearflag(FLAG_JOHNENDFIELD)
    }
    random(2)
    switch(var(VAR_RESULT)){
        case 0: 
            setflag(FLAG_CARNELIAN)
            clearflag(FLAG_MIFU_EVENT)
        default:
            setflag(FLAG_MIFU_EVENT)
            clearflag(FLAG_CARNELIAN)
    }
    random(2)
    switch(var(VAR_RESULT)){
        case 0:
            setflag(FLAG_CHISA_CC)
        default:
            clearflag(FLAG_CHISA_CC)
    }
    random(2)
    switch(var(VAR_RESULT)){
        case 0:
            setflag(FLAG_LAEVATAIN_EATING)
            clearflag(FLAG_LAEVATAIN_SHOOT)
        default:
            setflag(FLAG_LAEVATAIN_SHOOT)
            clearflag(FLAG_LAEVATAIN_EATING)
    }
    // random(3)
    // switch(var(VAR_RESULT)){
    //     case 0:
    //         setflag(FLAG_DRAGONS)
    //     default:
    //         clearflag(FLAG_DRAGONS)
    // }
    random(2)
    switch(var(VAR_RESULT)){
        case 0:
            setflag(FLAG_WEIQI)
        default:
            clearflag(FLAG_WEIQI)
    }
    //some other people in lounge (excl. with Gladiia)
    //Endmin & Penance
    //Various people at the photobooth
    //TangTang + MiFu
    //Laevatain position
}

script CC_Intro {
    lock
    setvar(VAR_INTRO, 1)
    applymovement(player, moves(walk_right))
    applymovement(chisa, moves(walk_right))
    waitmovement
    applymovement(receptionist, moves(emote_exclamation_mark))
    msgbox("Welcome! Have you gotten your\npasses yet?")
    applymovement(player, moves(face_up))
    applymovement(chisa, moves(walk_right, walk_up))
    waitmovement
    applymovement(chisa, moves(walk_in_place_up))
    waitmovement
    setspeaker(SP_NAME_CHISA)
    msgbox("Not yet! Here are our tickets.")
    applymovement(receptionist, moves(walk_in_place_down))
    msgbox("Let me check...")
    waitmessage
    applymovement(receptionist, moves(walk_left, delay_16*6, walk_right, face_down))
    msgbox("...Looks like everything's in order.\nHere you go.")
    waitmessage
    playse(MUS_OBTAIN_ITEM)
    msgbox("Obtained a CC pass!")
    waitse
    applymovement(player, moves(emote_heart))
    setspeaker(SP_NAME_PLAYER)
    msgbox("Thanks!")
    waitmessage
    applymovement(receptionist, moves(walk_in_place_down))
    msgbox("I see here that you both signed\nup for the CC simulation battles?")
    waitmessage
    applymovement(player, moves(emote_question_mark))
    waitmovement
    setspeaker(SP_NAME_PLAYER)
    msgbox("Huh? But I didn't-")
    applymovement(chisa, moves(jump_in_place_up))
    applymovement(player, moves(face_right))
    playse(SE_LEDGE)
    setspeaker(SP_NAME_CHISA)
    callnative(DestroyOther)
    msgbox("Yep, we did!")
    waitmessage
    callnative(CreateOtherVObjects)
    applymovement(player, moves(face_up))
    applymovement(receptionist, moves(walk_in_place_down))
    msgbox("Would you like me to explain how\neverything's set up?")
    dynmultichoice(0, 0, TRUE, 4, TRUE, DYN_MULTICHOICE_CB_NONE,
            "Yeah sure, give me the brief.",
            "I can figure it out myself!")
    switch(var(VAR_RESULT)){
        case 0: goto(CC_Intro_Explanation)
        case 1: goto(CC_Intro_NoExplanation)
    }
}

script CC_Intro_Explanation {
    special(SpawnCameraObject)
    msgbox("Gotcha.\p"
            "So, let's start with the basics.\p"
            "We have set up various different\ntrainer gauntlets where you fight\lcharacters from the games.\p"
            "Each gauntlet consists of 4 trainers.")
    closemessage
    applymovement(receptionist, moves(walk_right*2))
    applymovement(chisa, moves(delay_16*3, walk_down, face_right))
    applymovement(player, moves(delay_16*4, walk_right))
    applymovement(camera, moves(walk_diag_southeast*2, walk_right*8))
    waitmovement(camera)
    msgbox("You can start a gauntlet by talking\nto my colleague there.\p"
            "While in a gauntlet, you cannot swap\nout Pokemon, and you cannot change\ltheir moves or abilities.\p"
            "You will be healed after each fight,\nhowever.\p"
            "Additionally, the battles can have a\nvariety of risks enabled, which alter\lthe fights.\p"
            "This will generally make them more\ndifficult.\p"
            "Winning battles gives you some credit,\nwhich can be spent...")
    closemessage
    applymovement(camera, moves(walk_up*6, walk_diag_northeast))
    waitmovement
    msgbox("...Here. This is the Pokemon booth.\p"
            "Here, you can spend your credit to\nobtain pokemon for use in battle.\p"
            "Each pokemon will come out of the\nbox with 4 moves and 1 ability.\p"
            "The more you get the same Pokemon,\nthe more options will unlock for its\lmoves and abilities.")
    closemessage
    applymovement(camera, moves(walk_fast_right*10))
    msgbox("And over there is the Item booth.\p"
            "This is similar to the Pokemon booth,\nbut for items instead!")
    closemessage
    setobjectxyperm(chisa, 10, 22)
    fadescreen(FADE_TO_BLACK)
    applymovement(camera, moves(walk_faster_left*20, walk_faster_down*5))
    waitmovement
    special(RemoveCameraObject)
    fadescreen(FADE_FROM_BLACK)
    delay(30)
    applymovement(player, moves(face_up))
    applymovement(chisa, moves(face_up))
    msgbox("To start you off, we have provided\n3000 credits that you can spend at\lthe booths.\p"
            "That should cover it.")
    closemessage
    applymovement(player, moves(walk_in_place_up))
    waitmovement
    setspeaker(SP_NAME_PLAYER)
    msgbox("Thanks, miss!")
    closemessage
    applymovement(player, moves(walk_right*3, face_down))
    applymovement(chisa, moves(delay_16, walk_right*2, face_up))
    waitmovement
    setspeaker(SP_NAME_PLAYER)
    msgbox("Another take on battling, huh?")
    closemessage
    applymovement(chisa, moves(jump_in_place_up))
    playse(SE_LEDGE)
    waitmovement
    setspeaker(SP_NAME_CHISA)
    msgbox("Hehe, yep! I figured you'd enjoy this.")
    waitmessage
    applymovement(player, moves(walk_in_place_down))
    setspeaker(SP_NAME_PLAYER)
    msgbox("It definitely sounds interesting, but\nI was planning on just winding down\la bit from work.")
    closemessage
    applymovement(chisa, moves(face_right, delay_16*5, face_up))
    waitmovement
    setspeaker(SP_NAME_CHISA)
    msgbox("You say that, but you'll be in that\narena in no time.")
    closemessage
    setspeaker(SP_NAME_PLAYER)
    msgbox("...")
    closemessage
    applymovement(player, moves(delay_16*2, face_right))
    applymovement(chisa, moves(walk_right*2, face_left))
    waitmovement(chisa)
    setspeaker(SP_NAME_CHISA)
    msgbox("I'm going ahead then!")
    closemessage
    applymovement(chisa, moves(walk_right*3, walk_up*9))
    waitmovement
    setobjectxy(chisa, 38, 15)
    setobjectxyperm(chisa, 38, 15)
    setspeaker(SP_NAME_PLAYER)
    msgbox("Well, she's not off the mark there...")
    closemessage
    release
}

script CC_Intro_NoExplanation {
    applymovement(chisa, moves(walk_in_place_left))
    setspeaker(SP_NAME_CHISA)
    msgbox("Well look at miss confidence here!")
    applymovement(player, moves(face_right))
    applymovement(chisa, moves(lock_facing_direction, walk_right, unlock_facing_direction))
    setspeaker(SP_NAME_CHISA)
    msgbox("If you can figure it out, then I\nprobably can too!")
    closemessage
    applymovement(receptionist, moves(walk_in_place_down))
    applymovement(player, moves(face_up))
    applymovement(chisa, moves(face_up))
    waitmovement
    msgbox("Before you two head off, I need\nto mention you've got 3000 credits\lto start with.\pHave fun battling!")
    applymovement(chisa, moves(emote_heart))
    waitmovement
    setspeaker(SP_NAME_CHISA)
    msgbox("Thank you, miss.")
    waitmessage
    applymovement(chisa, moves(face_left))
    applymovement(player, moves(face_right))
    setspeaker(SP_NAME_CHISA)
    msgbox("Okay Tiana, I'll see you around!\nI'm gonna try my luck at the\lPokemon booth.")
    closemessage
    applymovement(chisa, moves(walk_right*8))
    waitmovement
    setobjectxy(chisa, 38, 15)
    setobjectxyperm(chisa, 38, 15)
    release
}

script TryLoadQueue {
    if (flag(FLAG_QUEUE_LOADED) != TRUE) {
        callnative(CreateQueue)
        setflag(FLAG_QUEUE_LOADED)
    }
}

script TryUnloadQueue {
    if (flag(FLAG_QUEUE_LOADED) == TRUE) {
        callnative(DestroyQueue)
        clearflag(FLAG_QUEUE_LOADED)
    }
    if (flag(FLAG_OTHER_LOADED) == TRUE) {
        callnative(DestroyOther)
        clearflag(FLAG_OTHER_LOADED)
    }
}

script TryLoadOther {
    if (flag(FLAG_OTHER_LOADED) != TRUE) {
        callnative(CreateOtherVObjects)
        setflag(FLAG_OTHER_LOADED)
    }
}


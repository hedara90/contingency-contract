}

script CC_Test {
    lock
    spinmorph(LOCALID_CC_NIAN, OBJ_EVENT_GFX_NIAN_TAILLESS)
    addobject(LOCALID_CC_TAIL)
    clearflag(FLAG_TAIL)
    release
}

script CC_Dragons {
    lock
    if(flag(FLAG_DRAGON_TALK)==TRUE){
        goto(CC_Dragons_Followup)
    }
    applymovement(shu, moves(walk_in_place_up))
    waitmovement
    setspeaker(SP_NAME_SHU)
    msgbox("I do hope washing my tail's not going\nto be too messy with the new paint.")
    waitmessage
    applymovement(nian, moves(face_down))
    waitmovement
    setspeaker(SP_NAME_NIAN)
    msgbox("Yeah, it has always been a pain for you,\nhasn't it?")
    waitmessage
    applymovement(zhuang, moves(walk_in_place_right))
    waitmovement
    setspeaker(SP_NAME_ZHUANG)
    msgbox("Huh? Wait, you painted it?")
    waitmessage
    applymovement(shu, moves(walk_in_place_up))
    applymovement(zhuang, moves(face_down))
    waitmovement
    setspeaker(SP_NAME_SHU)
    msgbox("Yeah! Normally it's the same color\nas yours.\p"
            "We even had to dye the hair to match\nShu's pattern.")
    waitmessage
    applymovement(zhuang, moves(emote_exclamation_mark))
    waitmovement
    setspeaker(SP_NAME_ZHUANG)
    msgbox("Wow, I didn't even notice it wasn't\nnatural.\pThat's amazing!")
    waitmessage
    applymovement(nian, moves(jump_in_place_left))
    playse(SE_LEDGE)
    waitmovement
    setspeaker(SP_NAME_NIAN)
    msgbox("Yeah, she's really good at that.\nYou should see her Mym cosplay!")
    waitmessage
    applymovement(nian, moves(face_down))
    msgbox("She created a whole armor to\nput on her tail for that one,\lsince Mym's tail so much bulkier.")
    waitmessage
    applymovement(shu, moves(walk_in_place_up))
    setspeaker(SP_NAME_SHU)
    msgbox("Yeah that... took some time to\nfigure out.\pVery happy with the result, though.")
    waitmessage
    applymovement(zhuang, moves(face_right))
    waitmovement
    setspeaker(SP_NAME_ZHUANG)
    msgbox("So is yours also painted then?")
    waitmessage
    applymovement(nian, moves(face_left))
    setspeaker(SP_NAME_NIAN)
    msgbox("Mine? Yeah, technically I suppose.")
    closemessage
    spinmorph(LOCALID_CC_NIAN, OBJ_EVENT_GFX_NIAN_TAILLESS)
    delay(30)
    addobject(LOCALID_CC_TAIL)
    clearflag(FLAG_TAIL)
    setspeaker(SP_NAME_NIAN)
    msgbox("But it's also made of foam.\nI'm just a regular ol' human after all.\p"
            "I just pop it on my back with\nsome magnets, and there's a harness\lunder my outfit it attaches to.")
    waitmessage
    applymovement(shu, moves(face_left))
    setspeaker(SP_NAME_SHU)
    msgbox("It's pretty convincing, right?")
    waitmessage
    applymovement(zhuang, moves(face_down))
    setspeaker(SP_NAME_ZHUANG)
    msgbox("You can say that, yeah.")
    closemessage
    spinmorph(LOCALID_CC_NIAN, OBJ_EVENT_GFX_NIAN)
    delay(30)
    removeobject(LOCALID_CC_TAIL)
    setflag(FLAG_TAIL)
    applymovement(zhuang, moves(face_right))
    msgbox("It never occured to me that it wasn't\nactually moving.")
    waitmessage
    applymovement(zhuang, moves(walk_in_place_right))
    msgbox("So what sorta paint do you use for\nyour tails?")
    waitmessage
    applymovement(shu, moves(face_up))
    setspeaker(SP_NAME_SHU)
    msgbox("We custom order it so it does what\nwe want.\lTo... mixed results.\p"
            "Turns out scales are pretty hard\nto keep dye on.")
    waitmessage
    applymovement(nian, moves(walk_in_place_left))
    setspeaker(SP_NAME_NIAN)
    msgbox("Say, if you ever want to do something\nthat needs tail mods,\lyou can shoot us a message!")
    waitmessage
    applymovement(shu, moves(face_up))
    applymovement(zhuang, moves(walk_in_place_right))
    setspeaker(SP_NAME_ZHUANG)
    msgbox("Ohhh I'll take you up on that!")
    setflag(FLAG_DRAGON_TALK)
    closemessage
    release
}

script CC_Dragons_Followup {
    applymovement(zhuang, moves(walk_in_place_right))
    setspeaker(SP_NAME_ZHUANG)
    msgbox("Oh, can I add you guys ingame?")
    waitmessage
    applymovement(nian, moves(jump_in_place_left))
    playse(SE_LEDGE)
    setspeaker(SP_NAME_NIAN)
    msgbox("Yep, sure thing!\p"
            "We can add you on PMChat as well if\nyou want.")
    waitmessage
    applymovement(shu, moves(walk_in_place_up))
    setspeaker(SP_NAME_SHU)
    msgbox("You can also come grab a bite with\nus tonight.\p"
            "There's a pretty bangin' noodle shop\ndown the road.")
    waitmessage
    setspeaker(SP_NAME_ZHUANG)
    applymovement(zhuang, moves(face_down))
    waitmovement
    msgbox("I think I know that place.\nCount me in!")
    closemessage
    applymovement(zhuang, moves(face_right))
    waitmovement
    release
}

const gladiia = LOCALID_CC_GLADIIA
const skadi = LOCALID_CC_SKADI
const irene = LOCALID_CC_IRENE
const ulpianus = LOCALID_CC_ULPIANUS
const specter = LOCALID_CC_SPECTER

script CC_AbyssalHunters {
    lock
    applymovement(irene, moves(walk_in_place_left))
    setspeaker(SP_NAME_IRENE)
    msgbox("Hey... where's your Gladiia?\nEveryone else is here.")//irene
    waitmessage
    applymovement(skadi, moves(face_up))
    waitmovement
    setspeaker(SP_NAME_SKADI)
    msgbox("Dunno. I only met her today,\njust like you.")
    waitmessage
    applymovement(specter, moves(walk_in_place_right))
    applymovement(skadi, moves(face_left))
    setspeaker(SP_NAME_SPECTER)
    msgbox("Oh, Sylva? She's not great at dealing\nwith crowds.\p"
            "She's probably somewhere less crowded.")
    waitmessage
    applymovement(irene, moves(emote_question_mark))
    setspeaker(SP_NAME_IRENE)
    msgbox("You've met her before the con?")
    applymovement(ulpianus, moves(walk_in_place_right))
    setspeaker(SP_NAME_ULPIANUS)
    msgbox("Yeah, we're friends. We've been hired\nfor smaller cons before as a group.\p"
            "But usually those don't require us to\ndo battles.")
    waitmessage
    applymovement(skadi, moves(walk_in_place_left))
    applymovement(irene, moves(face_down))
    setspeaker(SP_NAME_SKADI)
    msgbox("This her first time on a big stage?")
    waitmessage
    applymovement(irene, moves(face_left))
    applymovement(specter, moves(jump_in_place_right))
    setspeaker(SP_NAME_SPECTER)
    msgbox("Yes! She definitely deserves it.")
    waitmessage
    applymovement(ulpianus, moves(walk_in_place_right))
    setspeaker(SP_NAME_ULPIANUS)
    msgbox("She made her costume herself! It\nis incredibly well put together.\lShe just needs to get over the jitters.")
    waitmessage
    applymovement(skadi, moves(walk_in_place_left))
    applymovement(irene, moves(face_down))
    setspeaker(SP_NAME_SKADI)
    msgbox("Well, if she doesn't, then I'll just have\nto pick up the slack.\p"
            "I got a funny team from the organizers.\nPerish Trap!\p"
            "Quite excited to use it.")
    applymovement(ulpianus, moves(walk_in_place_right))
    applymovement(irene, moves(face_left))
    applymovement(specter, moves(face_down))
    setspeaker(SP_NAME_ULPIANUS)
    msgbox("Fortunately, they gave me something\nmuch more straightforward.\p"
            "I'm not a great battler, so mons that\njust hit moves and hit hard is a\lbetter fit for me...")
    waitmessage
    applymovement(specter, moves(walk_in_place_right))
    applymovement(ulpianus, moves(face_up))
    setspeaker(SP_NAME_SPECTER)
    msgbox("At least you guys get to stay dry\nduring your fights.")
    waitmessage
    applymovement(irene, moves(walk_in_place_left))
    setspeaker(SP_NAME_IRENE)
    msgbox("They gave you a rain team?\pThat's rough...")
    closemessage
    release
}

script CC_Gladiia {
    lock
    if(var(VAR_GLADIIA)==0){
        goto(CC_DidntFightGladiia)
    }
    elif(var(VAR_GLADIIA) < 3){
        goto(CC_FoughtGladiia)
    }
    elif (var(VAR_GLADIIA) == 3) {
        goto(CC_FoughtGladiia4times)
    }
    else {
        goto(CC_GladiiaEnd)
    }
}

script CC_DidntFightGladiia {
    setspeaker(SP_NAME_GLADIIA)
    msgbox("Oh man...\nWhat did they tell me now again?\p"
            "Just use the trapping moves? Hmm...")
    closemessage
    release
}

script CC_FoughtGladiia {
    faceplayer
    setspeaker(SP_NAME_GLADIIA)
    msgbox("Oh hey, it's you.")
    dynmultichoice(0, 0, FALSE, 5, FALSE, DYN_MULTICHOICE_CB_NONE,
            "Catching a break?")
    waitmessage
    setspeaker(SP_NAME_GLADIIA)
    msgbox("Yeah, it's a bit overwhelming.\nSo many people...")
    closemessage
    applymovement(gladiia, moves(face_right, delay_16*4, face_down))
    waitmovement
    setspeaker(SP_NAME_GLADIIA)
    msgbox("I really like cosplaying, but maybe\nI'll pass on this con next year")
    waitmessage
    applymovement(player, moves(jump_in_place_up))
    waitmovement
    playse(SE_LEDGE)
    setspeaker(SP_NAME_PLAYER)
    msgbox("But you looked like you had fun!")
    waitmessage
    applymovement(gladiia, moves(emote_question_mark))
    waitmovement
    waitmessage
    setspeaker(SP_NAME_GLADIIA)
    msgbox("Did I?\pI just felt nervous, being on such a\nstage with pokemon I'm not familiar with")
    dynmultichoice(0, 0, FALSE, 5, FALSE, DYN_MULTICHOICE_CB_NONE,
            "Are they unruly?")
    waitmessage
    setspeaker(SP_NAME_GLADIIA)
    msgbox("No they're absolute sweethearts.\nIt's just... weird, y'know?")
    waitmessage
    applymovement(player, moves(walk_in_place_up))
    setspeaker(SP_NAME_PLAYER)
    msgbox("Fair enough.\nHey, maybe it'll click later on!")
    waitmessage
    applymovement(gladiia, moves(face_right, delay_16*3, face_down))
    waitmovement
    setspeaker(SP_NAME_GLADIIA)
    msgbox("Mmm.. perhaps.")
    closemessage
    applymovement(gladiia, moves(face_right))
    waitmovement
    release
}

script CC_FoughtGladiia4times {
    faceplayer
    setspeaker(SP_NAME_GLADIIA)
    msgbox("Hey there!\nI think I finally caught my\lstride with the team")
    waitmessage
    applymovement(player, moves(emote_exclamation_mark))
    waitmovement
    setspeaker(SP_NAME_PLAYER)
    msgbox("Nice! Just needed some\nmore practice, huh?")
    waitmessage
    applymovement(gladiia, moves(walk_in_place_down))
    setspeaker(SP_NAME_GLADIIA)
    msgbox("Yeah, I guess so.\p"
            "But you were pretty good too!\p"
            "Even with all the things thrown\nyour way.\p"
            "Do you practice often?")
    waitmessage
    applymovement(player, moves(jump_in_place_up))
    setspeaker(SP_NAME_PLAYER)
    msgbox("Yeah! Quite a lot at my job.\nThough usually it's a bit... different.")
    waitmessage
    applymovement(gladiia, moves(emote_question_mark))
    waitmovement
    setspeaker(SP_NAME_GLADIIA)
    msgbox("Oh, how so?")
    waitmessage
    applymovement(player, moves(walk_in_place_up))
    setspeaker(SP_NAME_PLAYER)
    msgbox("I work at the Library, one of my tasks\nis deciphering & categorizing myths.\p"
            "My boss Satsuki has set up a\nwhole battle system for that.\p" 
            "Basically a juiced up rotation battle\nsystem")
    waitmessage
    applymovement(gladiia, moves(walk_in_place_down))
    setspeaker(SP_NAME_GLADIIA)
    msgbox("Is that where you can swap your\npokemon in and out quickly?")
    waitmessage
    applymovement(player, moves(jump_in_place_up))
    setspeaker(SP_NAME_PLAYER)
    msgbox("Yes! And there's a bunch of other\nthings too!")
    waitmessage
    applymovement(gladiia, moves(walk_in_place_down))
    setspeaker(SP_NAME_GLADIIA)
    msgbox("Sounds... rather odd, but you sound\nlike you enjoy it.\p"
            "I'll stick with what I'm doing\nright now, haha.")
    waitmessage
    applymovement(player, moves(walk_in_place_up))
    setspeaker(SP_NAME_PLAYER)
    msgbox("Alright, Good luck with that!\nLooking forward to facing you again.")
    waitmessage
    applymovement(gladiia, moves(emote_heart))
    setspeaker(SP_NAME_GLADIIA)
    msgbox("Yeah, for sure.")
    closemessage
    setvar(VAR_GLADIIA, 4)
    release
}

script CC_GladiiaEnd {
    setspeaker(SP_NAME_GLADIIA)
    msgbox("So, if I use Dugtrio to deal with\nsomething, they'll probably send in\la flying type after...\p"
            "Then I can use Memento and swap in\nJolteon... Hey, that may work!")
    waitmessage
    applymovement(gladiia, moves(emote_exclamation_mark, delay_16*3, face_down))
    playse(SE_PIN)
    waitmovement
    setspeaker(SP_NAME_GLADIIA)
    msgbox("Oh no, you weren't supposed\nto hear that!")
    closemessage
    applymovement(gladiia, moves(face_right))
    waitmovement  
    release
}


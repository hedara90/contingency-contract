    faceplayer
    setspeaker(SP_NAME_ARDELIA)
    msgbox("Oh hey there. Tiana, right?\p"
        "Chisa's told me all about you, we're\nbasically friends now.\p"
        "She's currently trying her luck again.\nMaybe this time...\p"
        "Anyway, I look forward to facing you!")
    closemessage
    release

}

script CC_Ardelia_ChisaHere {
    faceplayer
    setspeaker(SP_NAME_ARDELIA)

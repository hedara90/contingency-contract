script MonBanners {
    lock
    msgbox("Hello!\pDo you want to try your luck on a banner?")
    dynmultichoice(0, 0, FALSE, 4, FALSE, DYN_MULTICHOICE_CB_NONE,
                    "Indomitability of the Unbreakable Spirit",
                    "Fury of the Earthern Core",
                    "Memories of Months Past",
                    "No, I'm good for now!")
    switch(var(VAR_RESULT)) {
    case 0:
        gachaui(BANNER_INDOMITABILITY_OF_THE_UNBREAKABLE_SPIRIT)
    case 1:
        gachaui(BANNER_FURY_OF_THE_EARTHEN_CORE)
    case 2:
        gachaui(BANNER_MEMORIES_OF_MONTHS_PAST)
    default:
        msgbox("Next time then.")
        waitmessage
        release
        end
    }
    waitstate
    msgbox("Hope it went well.")
    waitmessage
    release
    end
}

script ItemBanner {
    lock
    msgbox("Hello!\pDo you want to try your luck on items?\nOr redeem what you want directly?")
    dynmultichoice(0, 0, FALSE, 3, FALSE, DYN_MULTICHOICE_CB_NONE,
                    "I'll try my luck!",
                    "I'll redeem an item.",
                    "Nothing for now.")
    switch(var(VAR_RESULT)) {
    case 0:
        gachaui(BANNER_ITEMS)
    case 1:
        msgbox("Of course, which rarity?\p4-star items cost 16 points,\n5-star 64, and 6-star costs 256.")
        callnative(DisplayItemPoints)
        dynmultichoice(0, 0, FALSE, 4, FALSE, DYN_MULTICHOICE_CB_NONE,
                        "4-Star!",
                        "5-Star!",
                        "6-Star!",
                        "Nevermind.")
        switch(var(VAR_RESULT)) {
        case 0:
            callnative(BuildListOf4StarItems)
            setvar(VAR_RESULT, 0)
            dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
            switch(var(VAR_RESULT)) {
            case 0:
                msgbox("See you another time then.")
            case MULTI_B_PRESSED:
                msgbox("See you another time then.")
            default:
                callnative(GiveItemFromPointShop)
                switch(var(VAR_RESULT)) {
                case 0:
                    msgbox("You don't have enough points for that.")
                case 1:
                    msgbox("Here you go!")
                }
            }
            callnative(HideItemPoints)
            waitmessage
            release
            end
        case 1:
            callnative(BuildListOf5StarItems)
            setvar(VAR_RESULT, 0)
            dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
            switch(var(VAR_RESULT)) {
            case 0:
                msgbox("See you another time then.")
            case MULTI_B_PRESSED:
                msgbox("See you another time then.")
            default:
                callnative(GiveItemFromPointShop)
                switch(var(VAR_RESULT)) {
                case 0:
                    msgbox("You don't have enough points for that.")
                case 1:
                    msgbox("Here you go!")
                }
            }
            callnative(HideItemPoints)
            waitmessage
            release
            end
        case 2:
            callnative(BuildListOf6StarItems)
            setvar(VAR_RESULT, 0)
            dynmultistack(0, 0, FALSE, 6, FALSE, 0, DYN_MULTICHOICE_CB_NONE)
            switch(var(VAR_RESULT)) {
            case 0:
                msgbox("See you another time then.")
            case MULTI_B_PRESSED:
                msgbox("See you another time then.")
            default:
                callnative(GiveItemFromPointShop)
                switch(var(VAR_RESULT)) {
                case 0:
                    msgbox("You don't have enough points for that.")
                case 1:
                    msgbox("Here you go!")
                }
            }
            callnative(HideItemPoints)
            waitmessage
            release
            end
        default:
            callnative(HideItemPoints)
            msgbox("See you another time!")
            waitmessage
            release
            end
        }
        callnative(HideItemPoints)
    default:
        msgbox("Next time then.")
        waitmessage
        release
        end
    }
    waitstate
    msgbox("Hope it went well.")
    waitmessage
    release
    end
}

script ChooseGauntlet {
    lock
    faceplayer
    msgbox("Which gauntlet do you want to fight?")
    dynmultichoice(0, 0, FALSE, 5, FALSE, DYN_MULTICHOICE_CB_NONE,
                    "Set Risks",
                    "Crisis Team",
                    "Wuling",
                    "Reconveners",
                    "Abyssal Hunters",
                    "Confluence of East and West",
                    "Band of Misfits",
                    "Not right now")
    getobjectfacingdirection(LOCALID_ATTENDANT_MAIN, VAR_TEMP_1)
    special(HealPlayerParty)
    setvar(VAR_GAUNTLET_POSITION, 0)
    switch(var(VAR_RESULT)) {
    case 0:
        riskui
        release
        end
    case 1:
        warpsilent(MAP_CRISIS_TEAM, 14, 11)
        waitstate
    case 2:
        warpsilent(MAP_WULING, 14, 11)
        waitstate
    case 3:
        warpsilent(MAP_RECONVENERS, 14, 11)
        waitstate
    case 4:
        warpsilent(MAP_ABYSSAL_HUNTERS, 14, 11)
        waitstate
    case 5:
        warpsilent(MAP_AK_YELLOW, 14, 11)
        waitstate
    case 6:
        warpsilent(MAP_AK_GREEN, 14, 11)
        waitstate
    default:
        msgbox("Hope you'll be back soon!")
    }
    waitmessage
    release
    end
}

script WelcomeCounter {
    lock
    msgbox("Enjoy your stay!")
    waitmessage
    release
    end
}

script CC_Chisa {
    lock
    getobjectcurrentxy(player, CURRENT_POSITION, VAR_TEMP_7, VAR_TEMP_8)
    callnative(GetMaxClearedRisk)
    if(var(VAR_RESULT) < 25){
        goto(CC_Chisa_LowScore)
    }
    elif(var(VAR_RESULT) < 32){
        goto(CC_Chisa_MidScore)
    }
    elif (var(VAR_RESULT) < 53){
        goto(CC_Chisa_HighScore)
    }
    else {
        goto(CC_Chisa_Record)
    }
}

script CC_Chisa_LowScore {
    setspeaker(SP_NAME_CHISA)
    msgbox("Okay lets see... Who do I try out now...")
    switch(var(VAR_CHISA_PARTY)){
        case 0: 
            msgbox("There's a lot of Double Battles here,\nso maybe Seismitoad and Altaria?\pSounds fun!")
        case 1:
            msgbox("I did just get Heatran, so maybe I\nshould use him...")
        case 2: 
            msgbox("Oh yeah! I maxed out Sandslash.\pHis signature move sounds good.\nSlush rush... Can I set snow, somehow?")
        case 3:
            msgbox("Is there a berry that would be good\nfor Mamoswine...")
        case 4:
            msgbox("I could just bring ol' reliable\nCorviknight.\pCan't go wrong with that.")
        case 5:
            msgbox("I got a lot of Nidokings, huh?\nMaybe I need to get my hands on a\lLife Orb")
        case 6:
            msgbox("What if I just pair Glaceon with\na Webs setter?\pMy options are... Masquerain\nand Araquanid?\lI'm still missing Galvantula.")
        case 7:
            msgbox("I could use the Burn risk together\nwith Jolteon's Charade.\pDid just unlock that one...")
        case 8:
            msgbox("This Steelix set looks insane.\nWhat were they thinking?")
        case 9:
            msgbox("Crobat with Contagion seems cool.\nJust wish I had him at higher Potential.")
    }
    if(flag(FLAG_TEMP_2)==TRUE){
        closemessage
        release
        end
    }
    waitmessage
    setspeaker(SP_NAME_PLAYER)
    msgbox("You look focused.")
    closemessage
    applymovement(chisa, moves(emote_double_exclamation_mark, delay_16*4, face_player))
    playse(SE_PIN)
    waitmovement
    setspeaker(SP_NAME_CHISA)
    msgbox("Wha- Oh, Tiana!")
    waitmessage
    applymovement(ardelia, moves(walk_in_place_left))
    setspeaker(SP_NAME_ARDELIA)
    msgbox("She's trying her best.")
    waitmessage
    applymovement(player, moves(face_right))
    setspeaker(SP_NAME_PLAYER)
    msgbox("Sounds like it, yes.")
    waitmessage
    applymovement(chisa, moves(jump_in_place_right))
    playse(SE_LEDGE)
    waitmovement
    setspeaker(SP_NAME_CHISA)
    msgbox("Hey hey! I got this!")
    waitmovement
    if(var(VAR_TEMP_8)==14){
        applymovement(player, moves(walk_in_place_down))
    }
    else {
        applymovement(player, moves(walk_in_place_up))
    }
    setspeaker(SP_NAME_PLAYER)
    msgbox("Deciding on your team?")
    waitmessage
    applymovement(chisa, moves(face_player))
    waitmovement
    setspeaker(SP_NAME_CHISA)
    msgbox("Yea, there's so many options... ugh...\p"
            "And I STILL don't have my Garchomp!")
    closemessage
    setflag(FLAG_TEMP_2)
    release
}

script CC_Chisa_MidScore {
    setspeaker(SP_NAME_CHISA)
    msgbox("Okay so, if i pick Area Lockdown and\nthen use Pokemon with pivoting moves,\lI can mitigate that risk...")
    waitmessage
    applymovement(ardelia, moves(walk_in_place_left))
    waitmovement
    setspeaker(SP_NAME_ARDELIA)
    msgbox("Just take Formation Breaker. Then you\ncan pick the Disabling, Tormenting and\lSuppressing risks for free.\p"
            "Way less restrictive.")
    waitmessage
    applymovement(chisa, moves(walk_in_place_right))
    setspeaker(SP_NAME_CHISA)
    msgbox("Hmm, that makes the entry hazards more\nannoying though...")
    waitmessage
    applymovement(chisa, moves(emote_exclamation_mark, delay_16*2, face_player))
    playse(SE_PIN)
    waitmovement
    setspeaker(SP_NAME_CHISA)
    msgbox("Oh, hey Tiana! Here to help me out?")
    waitmessage
    if(var(VAR_TEMP_8)==14){
        applymovement(player, moves(walk_in_place_down))
    }
    else {
        applymovement(player, moves(walk_in_place_up))
    }
    waitmovement
    setspeaker(SP_NAME_PLAYER)
    msgbox("Nope, just curious what you're up to.")
    waitmessage
    applymovement(ardelia, moves(walk_in_place_left))
    applymovement(player, moves(face_right))
    applymovement(chisa, moves(face_right))
    setspeaker(SP_NAME_ARDELIA)
    msgbox("She's trying - unsuccesfully - to get a\nscore better than 25.")
    waitmessage
    applymovement(chisa, moves(jump_in_place_right))
    playse(SE_LEDGE)
    waitmovement
    setspeaker(SP_NAME_CHISA)
    msgbox("Hey, that's no fair!\p"
            "You get to benefit from everything\nI switch on!\p"
            "Why don't you try it then?")
    waitmessage
    applymovement(ardelia, moves(emote_heart))
    waitmovement
    setspeaker(SP_NAME_ARDELIA)
    msgbox("Fue, you think I am just here as\nyour opponent?\p"
            "I helped test everything!\nMy record is 53.")
    waitmessage
    applymovement(chisa, moves(jump_in_place_right*2))
    playse(SE_LEDGE)
    waitse
    playse(SE_LEDGE)
    waitmovement
    setspeaker(SP_NAME_CHISA)
    msgbox("What?? And you aren't helping me??\p"
            "I thought we were friends...")
    waitmessage
    applymovement(ardelia, moves(walk_in_place_left))
    setspeaker(SP_NAME_ARDELIA)
    msgbox("Well, as per the rules,\nI can't tell you how I did that.")
    waitmessage
    if(var(VAR_TEMP_8)==14){
        applymovement(player, moves(walk_in_place_down))
    }
    else {
        applymovement(player, moves(walk_in_place_up))
    }
    setspeaker(SP_NAME_PLAYER)
    msgbox("I already beat 25!")
    waitmessage
    applymovement(ardelia, moves(walk_in_place_left))
    setspeaker(SP_NAME_ARDELIA)
    msgbox("Oh, good job!")
    applymovement(chisa, moves(emote_exclamation_mark, delay_16*2, face_player))
    waitmovement
    setspeaker(SP_NAME_CHISA)
    msgbox("What!? Oh man, am I always gonna be\na step behind you?")
    waitmessage
    if(var(VAR_TEMP_8)==14){
        applymovement(chisa, moves(jump_in_place_up))
    }
    else {
        applymovement(chisa, moves(jump_in_place_down))
    }
    playse(SE_LEDGE)
    waitmovement
    setspeaker(SP_NAME_CHISA)
    msgbox("How did you do it!\p"
            "No, wait. Don't tell me.\nI can do it on my own, just you wait.")
    waitmessage
    applymovement(chisa, moves(face_right))
    setspeaker(SP_NAME_CHISA)
    msgbox("Just gotta figure out which\nmons to use...\p"
            "There's so many cool ones.")
    closemessage
    release
}

script CC_Chisa_HighScore {
    if(var(VAR_TEMP_8)==14){
        applymovement(chisa, moves(jump_in_place_up))
    }
    else {
        applymovement(chisa, moves(jump_in_place_down))
    }
    playse(SE_LEDGE)
    waitmovement
    setspeaker(SP_NAME_CHISA)
    msgbox("Tiana! I did it! I got to 36, even!")
    waitmessage
    applymovement(player, moves(emote_heart))
    waitmovement
    setspeaker(SP_NAME_PLAYER)
    msgbox("Heh, that's more like you.")
    waitmessage
    applymovement(chisa, moves(emote_question_mark))
    setspeaker(SP_NAME_CHISA)
    msgbox("What are you at right now?")
    callnative(GetMaxClearedRisk)
    if(var(VAR_RESULT) < 36){
        setspeaker(SP_NAME_PLAYER)
        msgbox("Less than that...")
        applymovement(chisa, moves(emote_exclamation_mark))
        playse(SE_PIN)
        setspeaker(SP_NAME_CHISA)
        msgbox("Oohh, so I win!")
        waitmessage
        if(var(VAR_TEMP_8)==14){
            applymovement(player, moves(walk_in_place_down))
        }
        else {
            applymovement(player, moves(walk_in_place_up))
        }
        setspeaker(SP_NAME_PLAYER)
        msgbox("Oh I am not done yet, don't worry.")
        waitmessage
        applymovement(ardelia, moves(walk_in_place_left))
        waitmovement
        setspeaker(SP_NAME_ARDELIA)
        msgbox("Well well, aren't you two fired up.")
        closemessage
    }
    else {
        setspeaker(SP_NAME_PLAYER)
        msgbox("Higher than that!")
        waitmessage
        applymovement(chisa, moves(emote_exclamation_mark))
        playse(SE_PIN)
        waitmovement
        setspeaker(SP_NAME_CHISA)
        msgbox("Goodness, how do you keep doing that!")
        waitmessage
        applymovement(ardelia, moves(walk_in_place_left))
        applymovement(chisa, moves(face_right))
        applymovement(player, moves(face_right))
        setspeaker(SP_NAME_ARDELIA)
        msgbox("Well, you did tell me she's just better\nthan you.")
        waitmessage
        applymovement(chisa, moves(walk_in_place_right))
        waitmovement
        setspeaker(SP_NAME_CHISA)
        msgbox("She is. Annoyingly so.")
        waitmessage
        applymovement(chisa, moves(jump_in_place_right))
        playse(SE_LEDGE)
        waitmovement
        setspeaker(SP_NAME_CHISA)
        msgbox("Ohwell, I think I can push it some more!")
        closemessage
    }
    release
    end
        
}

script CC_Chisa_Record {
    setspeaker(SP_NAME_PLAYER)
    msgbox("Hey Chisa! I beat Ardelia's record!")
    waitmessage
    applymovement(chisa, moves(face_player, emote_exclamation_mark))
    applymovement(ardelia, moves(emote_exclamation_mark))
    setspeaker(SP_NAME_CHISA)
    msgbox("You beat WHAT?\p"
            "I didn't think that was possible!")
    applymovement(ardelia, moves(walk_in_place_left))
    applymovement(player, moves(face_right))
    setspeaker(SP_NAME_ARDELIA)
    msgbox("Sheesh, I didn't expect anyone to\ndo that.\p"
            "That's incredibly impressive.\p"
            "Chisa really undersold you, even.")
    waitmessage
    if(var(VAR_TEMP_8)==14){
            applymovement(player, moves(face_down))
            applymovement(chisa, moves(walk_in_place_up))
        }
        else {
            applymovement(player, moves(face_up))
            applymovement(player, moves(walk_in_place_down))
        }
        waitmovement
    setspeaker(SP_NAME_CHISA)
    msgbox("I don't think I'll hit that.\n38 was challenging enough for me...")
    waitmessage
        if(var(VAR_TEMP_8)==14){
            applymovement(player, moves(walk_in_place_down))
        }
        else {
            applymovement(player, moves(walk_in_place_up))
        }
        waitmovement
    setspeaker(SP_NAME_PLAYER)
    msgbox("Hey, that's still really good!")
    waitmessage
    applymovement(ardelia, moves(walk_in_place_left))
    waitmovement
    setspeaker(SP_NAME_ARDELIA)
    msgbox("Yeah, you should be proud of that.")
    waitmessage
    applymovement(chisa, moves(face_player))
    setspeaker(SP_NAME_CHISA)
    msgbox("Anyway! I think I'll raise a Crobat.\nNever realized how cool this guy is.")
    closemessage
}

script CC_Ardelia {
    lock
    if(flag(FLAG_CHISA_CC)){
    goto(CC_Ardelia_ChisaNotHere)
    }
    else {
        goto(CC_Ardelia_ChisaHere)
    }
}


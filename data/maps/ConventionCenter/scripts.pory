}

const guard1 = LOCALID_CC_GUARD1
const guard2 = LOCALID_CC_GUARD2
const guard3 = LOCALID_CC_GUARD3
const gilberta1 = LOCALID_CC_GILBERTA1
const gilberta2 = LOCALID_CC_GILBERTA2
const gilberta3 = LOCALID_CC_GILBERTA3

script CC_GilbertaEntrance {
    if(var(VAR_TEMP_9)==1){
        goto(CC_GilbertaEntrance_After)
    }
    lock
    applymovement(guard1, moves(emote_exclamation_mark))
    playse(SE_PIN)
    waitmovement
    msgbox("Hey, girl! Get off that Lung!")
    waitmessage
    applymovement(gilberta1, moves(face_left))
    msgbox("Allright, fiiiiine")
    applymovement(gilberta1, moves(jump_right, lock_facing_direction, walk_down, unlock_facing_direction))
    playse(SE_LEDGE)
    msgbox("Heppy now?")
    setvar(VAR_TEMP_9, 1)
    release
}

script CC_GilbertaEntrance_After {
    lock
    applymovement(gilberta1, moves(walk_in_place_right))
    waitmovement
    msgbox("I won't go up there anymore, okay?")
    closemessage
    applymovement(guard1, moves(walk_in_place_left))
    waitmovement
    msgbox("I'm sure you won't.")
    closemessage
    release
}


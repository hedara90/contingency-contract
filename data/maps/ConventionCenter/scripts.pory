const gambler = LOCALID_CC_GAMBLER
const perlica = LOCALID_CC_PERLICA

script CC_Perlica {
    lock
    applymovement(gambler, moves(walk_in_place_right))
    msgbox("I swear this gacha is rigged!")
    applymovement(gambler, moves(jump_in_place_right))
    playse(SE_LEDGE)
    waitmovement
    msgbox("I've sank so many pulls into the banner,\nyet I still don't have Altaria!")
    closemessage
    applymovement(perlica, moves(walk_in_place_left))
    msgbox("That unlucky, huh?")
    closemessage
    applymovement(gambler, moves(walk_in_place_right))
    msgbox("Yeah!\p")
    closemessage
    applymovement(gambler, moves(emote_exclamation_mark))
    playse(SE_PIN)
    waitmovement
    msgbox("Hey, since you're one of the battlers,\ndo you know if they're duping me??\p"
            "I mean, I've gotten 4 Slowkings and\n2 Mola's, but I've yet to see the\lcloudbird.")
    closemessage
    applymovement(perlica, moves(face_down))
    msgbox("...")
    closemessage
    applymovement(perlica, moves(face_left))
    msgbox("Just keep at it.\nYou'll get one eventually.")
    closemessage
    applymovement(perlica, moves(face_down))
    msgbox("And maybe read the banner details.")
    closemessage
    release
}

script CC_Itemguy {
    lock
    faceplayer
    msgbox("Dang. I've gotten TOO lucky.\p"
            "I pulled all the 6 star items in 40 pulls.\nBut I was looking for a Loaded Dice...\p"
            "I'll get it eventually, I suppose.")
    closemessage
    release
}

const carnelian = LOCALID_CC_CARNELIAN
const elysium = LOCALID_CC_ELYSIUM

script CC_Carnelian {
    lock
    applymovement(carnelian, moves(walk_in_place_up))
    waitmovement
    msgbox("What's your favourite Arknights song?\p"
            "I'm a big fan of the Operation Pyrite\ntheme, but the new IS7 boss theme \lis great too.")
    closemessage
    applymovement(elysium, moves(walk_in_place_down))
    msgbox("I want you on your knees...")
    delay(60)
    closemessage
    applymovement(carnelian, moves(emote_question_mark))
    waitmovement
    msgbox("...sorry?")
    closemessage
    applymovement(elysium, moves(walk_in_place_down))
    msgbox("This buried love grows teeth...")
    closemessage
    msgbox("Are these like, some lyrics?")
    closemessage
    applymovement(elysium, moves(walk_in_place_down))
    msgbox("A thousand stars weeping...")
    closemessage
    delay(60)
    msgbox("Dang, you don't know it?\p"
        "Well, now I look silly, don't I?")
    closemessage
    applymovement(carnelian, moves(walk_in_place_up))
    msgbox("You could've just told me the song name\ninstead of telling me to get on my\lknees!\p"
            "Thats just weird man.")
    closemessage
    applymovement(elysium, moves(face_left, delay_16*5, face_down))
    msgbox("Yeah... I can't disagree with that...")
    closemessage
    applymovement(carnelian, moves(walk_in_place_up))
    msgbox("So what is the song name then?")
    closemessage
    applymovement(elysium, moves(emote_exclamation_mark))
    waitmovement
    msgbox("Oh it's Alleikhreos's intro theme.\nAll 4 of them are great!")
    closemessage
    release
}
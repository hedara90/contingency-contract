mapscripts ConventionCenter_MapScripts {
    MAP_SCRIPT_ON_RESUME {
        callnative(CreateQueue)
    }
}

script LastQueuer {
    lock
    turnvobject(0, DIR_NORTH)
    msgbox("I hope this queue goes fast…")
    waitmessage
    turnvobject(0, DIR_SOUTH)
    release
    end
}


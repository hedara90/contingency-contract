mapscripts ConventionCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: CC_OnTransition
    MAP_SCRIPT_ON_RESUME {
        if (flag(FLAG_QUEUE_LOADED) == TRUE) {
            callnative(CreateQueue)
        }
        if (flag(FLAG_OTHER_LOADED) == TRUE) {
            callnative(CreateOtherVObjects)
        }
    }
}


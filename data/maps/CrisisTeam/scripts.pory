mapscripts CrisisTeam_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: CrisisTeam_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_5, 0: CrisisTeam_Setup
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_5, 0: CrisisTeam_OnGauntletStart
    ]
}

const player = OBJ_EVENT_ID_PLAYER
const tiana = LOCALID_TIANA

script CrisisTeam_OnTransition {
    if(var(VAR_GAUNTLET_POSITION)==0){
        setobjectxyperm(tiana, 10, 11)
    }
}

script CrisisTeam_Setup {
    hideobjectat(player, MAP_CRISIS_TEAM)
}

script CrisisTeam_OnGauntletStart {
    setvar(VAR_TEMP_5, 1)
    call(Gauntlet_SetupCamera)
    goto(CrisisTeam_StartBattle)
}

script CrisisTeam_StartBattle {
    switch(var(VAR_GAUNTLET_POSITION)) {
        case 0: 
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(CrisisTeam_Xaihi)
            call(Gauntlet_PostBattle)
            goto(CrisisTeam_StartBattle)
        case 1:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(CrisisTeam_Chen)
            call(Gauntlet_PostBattle)
            goto(CrisisTeam_StartBattle)
        case 2:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(CrisisTeam_Perlica)
            call(Gauntlet_PostBattle)
            goto(CrisisTeam_StartBattle)
        case 3:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(CrisisTeam_Endmin)
            call(CrisisTeam_WonGauntlet)
    }
}

script CrisisTeam_WonGauntlet {
    call(Gauntlet_AfterGauntletWin)
    victoryscreen(GAUNTLET_CRISIS_TEAM, FALSE)
    waitstate
    call(Gauntlet_WarpOutAfterWin)
}

script CrisisTeam_Xaihi {
    msgbox(XaihiBeforeBattle)
    trainerbattle_no_intro(TRAINER_XAIHI, XaihiAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(XaihiAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(XaihiAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text XaihiBeforeBattle {
    "With my prayers, I shall lift up\n"
    "those who have gone astray."
}

text XaihiAfterBattle {
    "Contemplation… computation…\n"
    "utterance… abandonment."
}

text XaihiAfterBattle_Win {
    "I shall return to my work. Chen tells\n"
    "me the toaster has broken again,\l"
    "and my prayers are all that will\l"
    "cleanse its codes of malice."
}

text XaihiAfterBattle_Lose {
    "Behold, the benevolence of the Law\n"
    "made manifest. I shall pray for\l"
    "wisdom to bless your terminal and\l"
    "its boxes."
}

script CrisisTeam_Chen {
    msgbox(ChenBeforeBattle)
    trainerbattle_no_intro(TRAINER_CHEN, ChenAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(ChenAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(ChenAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text ChenBeforeBattle {
    "Get ready? Heh. My blades are\n"
    "always ready as they never rest!"
}

text ChenAfterBattle {
    "Hmm… Maybe a true master should\n"
    "wear lighter gear."
}

text ChenAfterBattle_Win {
    "So this… and follow up with this?\n"
    "Alright, I got it!\p"
    "I'm grabbing a front row seat for\n"
    "the rest of these matches!"
}

text ChenAfterBattle_Lose {
    "I can use standard issue\n"
    "weaponry to unleash a healthy dose\l"
    "of whoop-ass!"
}

script CrisisTeam_Perlica {
    msgbox(PerlicaBeforeBattle)
    trainerbattle_no_intro(TRAINER_PERLICA, PerlicaAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(PerlicaAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(PerlicaAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text PerlicaBeforeBattle {
    "Sterilize this area!"
}

text PerlicaAfterBattle {
    "Don't push yourself too hard.\n"
    "Keep yourself rested and well."
}

text PerlicaAfterBattle_Win {
    "All Operators accounted for. The\n"
    "team is ready for the mission."
}

text PerlicaAfterBattle_Lose {
    "Though I am a little too young and\n"
    "untested, my mind is set. I shall\l"
    "fulfill my duties as Supervisor of\l"
    "Endfield Industries."
}

script CrisisTeam_Endmin {
    msgbox(EndminBeforeBattle)
    trainerbattle_no_intro(TRAINER_ENDMIN, EndminAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(EndminAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(EndminAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text EndminBeforeBattle {
    "Originium will carve a path for us."
}

text EndminAfterBattle {
    "Not too shabby."
}

text EndminAfterBattle_Win {
    "No need to worry. We'll regroup and\n"
    "figure this out."
}

text EndminAfterBattle_Lose {
    "I hear Originium singing."
}

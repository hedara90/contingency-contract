mapscripts CrisisTeam_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: CrisisTeam_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_5, 0: CrisisTeam_Setup
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_5, 0: CrisisTeam_OnGauntletStart
    ]
}

const player = OBJ_EVENT_ID_PLAYER
const tiana = LOCALID_TIANA

script CrisisTeam_OnTransition {
    if(var(VAR_GAUNTLET_POSITION)==0){
        setobjectxyperm(tiana, 10, 11)
    }
}

script CrisisTeam_Setup {
    hideobjectat(player, MAP_CRISIS_TEAM)
}

script CrisisTeam_OnGauntletStart {
    setvar(VAR_TEMP_5, 1)
    call(Gauntlet_SetupCamera)
    goto(CrisisTeam_StartBattle)
}

script CrisisTeam_StartBattle {
    switch(var(VAR_GAUNTLET_POSITION)) {
        case 0: 
            call(Gauntlet_OpponentMovement_BeforeBattle)
            call(CrisisTeam_Xaihi)
            call(Gauntlet_PostBattle)
            goto(CrisisTeam_StartBattle)
        case 1:
            call(Gauntlet_OpponentMovement_BeforeBattle)
            call(Gauntlet_MovePlayerBeforeBattle)
            call(CrisisTeam_Chen)
            call(Gauntlet_PostBattle)
            goto(CrisisTeam_StartBattle)
        case 2:
            call(Gauntlet_OpponentMovement_BeforeBattle)
            call(Gauntlet_MovePlayerBeforeBattle)
            call(CrisisTeam_Perlica)
            call(Gauntlet_PostBattle)
            goto(CrisisTeam_StartBattle)
        case 3:
            call(Gauntlet_OpponentMovement_BeforeBattle)
            call(Gauntlet_MovePlayerBeforeBattle)
            call(CrisisTeam_Endmin)
            call(Gauntlet_PostBattle)
    }
}

script CrisisTeam_Xaihi {
    msgbox(XaihiBeforeBattle)
    trainerbattle_no_intro(TRAINER_XAIHI, XaihiAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(XaihiAfterBattle_Lose)
        case 1:
            msgbox(XaihiAfterBattle_Win)
    }
    return
}

text XaihiBeforeBattle {
    "Hello"
}

text XaihiAfterBattle {
    ""
}

text XaihiAfterBattle_Win {
    ""
}

text XaihiAfterBattle_Lose {
    ""
}


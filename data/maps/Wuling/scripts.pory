mapscripts Wuling_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Wuling_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_5, 0: Wuling_Setup
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_5, 0: Wuling_OnGauntletStart
    ]
}

const player = OBJ_EVENT_ID_PLAYER
const tiana = LOCALID_TIANA

script Wuling_OnTransition {
    if(var(VAR_GAUNTLET_POSITION)==0){
        setobjectxyperm(tiana, 10, 11)
    }
}

script Wuling_Setup {
    hideobjectat(player, MAP_WULING)
}

script Wuling_OnGauntletStart {
    setvar(VAR_TEMP_5, 1)
    call(Gauntlet_SetupCamera)
    goto(Wuling_StartBattle)
}

script Wuling_StartBattle {
    switch(var(VAR_GAUNTLET_POSITION)) {
        case 0: 
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(Wuling_TangTang)
            call(Gauntlet_PostBattle)
            goto(Wuling_StartBattle)
        case 1:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(Wuling_MiFu)
            call(Gauntlet_PostBattle)
            goto(Wuling_StartBattle)
        case 2:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(Wuling_Arcane)
            call(Gauntlet_PostBattle)
            goto(Wuling_StartBattle)
        case 3:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(Wuling_ZhuangFangyi)
            goto(Wuling_WonGauntlet)
    }
}

script Wuling_WonGauntlet {
    call(Gauntlet_AfterGauntletWin)
    victoryscreen(GAUNTLET_WULING, FALSE)
    waitstate
    call(Gauntlet_WarpOutAfterWin)
}

script Wuling_TangTang {
    msgbox(TangTangBeforeBattle)
    trainerbattle_no_intro(TRAINER_TANGTANG, TangTangAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(TangTangAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(TangTangAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text TangTangBeforeBattle {
    "Hello"
}

text TangTangAfterBattle {
    ""
}

text TangTangAfterBattle_Win {
    ""
}

text TangTangAfterBattle_Lose {
    ""
}


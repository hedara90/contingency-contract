mapscripts Wuling_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Wuling_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_GAUNTLETHANDLING, 0: Wuling_Setup
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_GAUNTLETHANDLING, 0: Wuling_OnGauntletStart
        VAR_GAUNTLETHANDLING, 1: Wuling_OnSaveResume
    ]
    MAP_SCRIPT_ON_RESUME {
        callnative(SpectatorVObjects)
    }
}

const player = OBJ_EVENT_ID_PLAYER
const tiana = LOCALID_TIANA

script Wuling_OnTransition {
    if(var(VAR_GAUNTLET_POSITION)==0){
        setobjectxyperm(tiana, 10, 11)
    }
}

script Wuling_Setup {
    hideobjectat(player, MAP_WULING)
}

script Wuling_OnGauntletStart {
    setvar(VAR_GAUNTLETHANDLING, 1)
    call(Gauntlet_SetupCamera)
    goto(Wuling_StartBattle)
}

script Wuling_OnSaveResume {
    call(Gauntlet_ResumeSave)
    goto(Wuling_StartBattle)
}

script Wuling_StartBattle {
    switch(var(VAR_GAUNTLET_POSITION)) {
        case 0: 
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(Wuling_TangTang)
            call(Gauntlet_PostBattle)
            goto(Wuling_StartBattle)
        case 1:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(Wuling_MiFu)
            call(Gauntlet_PostBattle)
            goto(Wuling_StartBattle)
        case 2:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(Wuling_Arcane)
            call(Gauntlet_PostBattle)
            goto(Wuling_StartBattle)
        case 3:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(Wuling_ZhuangFangyi)
            goto(Wuling_WonGauntlet)
    }
}

script Wuling_WonGauntlet {
    call(Gauntlet_AfterGauntletWin)
    victoryscreen(GAUNTLET_WULING, FALSE)
    waitstate
    call(Gauntlet_WarpOutAfterWin)
}

script Wuling_TangTang {
    setspeaker(SP_NAME_TANGTANG)
    msgbox(TangTangBeforeBattle)
    trainerbattle_no_intro(TRAINER_TANGTANG, TangTangAfterBattle)
    // msgbox("Good battle!")
    closemessage
    setspeaker(SP_NAME_TANGTANG)
    switch(var(VAR_RESULT)){
        default:
            msgbox(TangTangAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(TangTangAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text TangTangBeforeBattle {
    "Your crew's pretty tough, but I've\n"
    "never lost a real spar!"
}

text TangTangAfterBattle {
    "What a scuffle!"
}

text TangTangAfterBattle_Win {
    "Huff… I'm totally beat… Can't go on?\n"
    "Hah! The word can't isn't in my\l"
    "dictionary! I'll get you next time!"
}

text TangTangAfterBattle_Lose {
    "Wow you're strong! Maybe you can\n"
    "even take down that mad woman!"
}

script Wuling_MiFu {
    setspeaker(SP_NAME_MIFU)
    msgbox(MiFuBeforeBattle)
    trainerbattle_no_intro(TRAINER_MIFU, MiFuAfterBattle)
    // msgbox("Good battle!")
    closemessage
    setspeaker(SP_NAME_MIFU)
    switch(var(VAR_RESULT)){
        default:
            msgbox(MiFuAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(MiFuAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text MiFuBeforeBattle {
    "Managed to get through the little\n"
    "kitty, huh? Heh, sounds about\l"
    "right.\p"
    "If you're ready to fight, I'm in."
}

text MiFuAfterBattle {
    "Hah, I see a worthy opponent."
}

text MiFuAfterBattle_Win {
    "I never concede if I'm still on my\n"
    "feet, but I know when my team's\l"
    "had enough.\p"
    "Good luck when you meet boss later."
}

text MiFuAfterBattle_Lose {
    "I bond with people by fighting them.\n"
    "Only those who can take a win, a\l"
    "loss, and a beating are reliable.\p"
    "You? Hmm… I think you're way\l"
    "beyond reliable."
}

script Wuling_Arcane {
    setspeaker(SP_NAME_ARCANE)
    msgbox(ArcaneBeforeBattle)
    callnative(GetRandomArcane)
    switch (var(VAR_RESULT)) {
        case 0:
            trainerbattle_no_intro(TRAINER_ARCANE_SINGLES, ArcaneAfterBattle)
        case 1:
            trainerbattle_no_intro(TRAINER_ARCANE_DOUBLES, ArcaneAfterBattle)
    }
    // msgbox("Good battle!")
    closemessage
    setspeaker(SP_NAME_ARCANE)
    switch (var(VAR_RESULT)){
        default:
            msgbox(ArcaneAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(ArcaneAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text ArcaneBeforeBattle {
    "I will uphold the honor of the\n"
    "Yinglungs."
}

text ArcaneAfterBattle {
    "I used to spend all night poring\n"
    "over combat records."
}

text ArcaneAfterBattle_Win {
    "Thank you for the match… I don't\n"
    "often get to be in situations like\l"
    "this as a Task Leader, so it's… kind\l"
    "of novel."
}

text ArcaneAfterBattle_Lose {
    "Hone yourself to extreme perfection,\n"
    "and you can calmly prevail, no\l"
    "matter the situation."
}

script Wuling_ZhuangFangyi {
    setspeaker(SP_NAME_ZHUANG)
    msgbox(ZhuangFangyiBeforeBattle)
    trainerbattle_no_intro(TRAINER_FANGYI, ZhuangFangyiAfterBattle)
    // msgbox("Good battle!")
    closemessage
    setspeaker(SP_NAME_ZHUANG)
    switch(var(VAR_RESULT)){
        default:
            msgbox(ZhuangFangyiAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(ZhuangFangyiAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text ZhuangFangyiBeforeBattle {
    "Mi Fu told me about your match. I'm\n"
    "so excited! I've just finished a\l"
    "refreshing cup of tea and I'm eager\l"
    "to get started."
}

text ZhuangFangyiAfterBattle {
    "My heart is racing! It's just like\n"
    "making a breakthrough in the lab."
}

text ZhuangFangyiAfterBattle_Win {
    "What d'you think of the Chubby Lungs\n"
    "around the convention centre? I\l"
    "designed them you know! Aren't they\l"
    "just the cutest?"
}

text ZhuangFangyiAfterBattle_Lose {
    "Never hesitate to take a break. What\n"
    "lies ahead could prove even more\l"
    "demanding."
}

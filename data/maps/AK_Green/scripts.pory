mapscripts AK_Green_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: AKGreen_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_5, 0: AKGreen_Setup
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_5, 0: AKGreen_OnGauntletStart
    ]
    MAP_SCRIPT_ON_RESUME {
        callnative(SpectatorVObjects)
    }
}

const player = OBJ_EVENT_ID_PLAYER
const tiana = LOCALID_TIANA

script AKGreen_OnTransition {
    if(var(VAR_GAUNTLET_POSITION)==0){
        setobjectxyperm(tiana, 10, 11)
    }
}

script AKGreen_Setup {
    hideobjectat(player, MAP_AK_GREEN)
}

script AKGreen_OnGauntletStart {
    setvar(VAR_TEMP_5, 1)
    call(Gauntlet_SetupCamera)
    goto(AKGreen_StartBattle)
}

script AKGreen_StartBattle {
    switch(var(VAR_GAUNTLET_POSITION)) {
        case 0: 
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(AKGreen_Carnelian)
            call(Gauntlet_PostBattle)
            goto(AKGreen_StartBattle)
        case 1:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(AKGreen_Penance)
            call(Gauntlet_PostBattle)
            goto(AKGreen_StartBattle)
        case 2:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(AKGreen_Pramanix)
            call(Gauntlet_PostBattle)
            goto(AKGreen_StartBattle)
        case 3:
            call(Gauntlet_MovePlayerBeforeBattle)
            call(Gauntlet_MoveOpponentBeforeBattle)
            call(AKGreen_Fiametta)
            call(AKGeen_WonGauntlet)
    }
}

script AKGeen_WonGauntlet {
    call(Gauntlet_AfterGauntletWin)
    victoryscreen(GAUNTLET_AK_GREEN, FALSE)
    waitstate
    call(Gauntlet_WarpOutAfterWin)
}

script AKGreen_Carnelian {
    setspeaker(SP_NAME_CARNELIAN)
    msgbox(CarnelianBeforeBattle)
    trainerbattle_no_intro(TRAINER_CARNELIAN, CarnelianAfterBattle)
    // msgbox("Good battle!")
    closemessage
    setspeaker(SP_NAME_CARNELIAN)
    switch(var(VAR_RESULT)){
        default:
            msgbox(CarnelianAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(CarnelianAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text CarnelianBeforeBattle {
    "Greetings… Let's forgo the bothersome\n"
    "formalities and get this thing\l"
    "started."
}

text CarnelianAfterBattle {
    "I see. These are tactics worth\n"
    "studying."
}

text CarnelianAfterBattle_Win {
    "My little sister sometimes talks in\n"
    "her sleep. This one time, I even\l"
    "caught her talking bad about me.\p"
    "Makes me wonder what others might\n"
    "be talking about while snoozing."
}

text CarnelianAfterBattle_Lose {
    "It's been a long time since my blood\n"
    "boiled like this. Thank you for the\l"
    "battle."
}

script AKGreen_Penance {
    setspeaker(SP_NAME_PENANCE)
    msgbox(PenanceBeforeBattle)
    trainerbattle_no_intro(TRAINER_PENANCE, PenanceAfterBattle)
    // msgbox("Good battle!")
    closemessage
    setspeaker(SP_NAME_PENANCE)
    switch(var(VAR_RESULT)){
        default:
            msgbox(PenanceAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(PenanceAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text PenanceBeforeBattle {
    "Whether or not you are burdened by\n"
    "a criminal record is unimportant to\l"
    "me. All I ask is that in this coming\l"
    "battle, our goals might be aligned."
}

text PenanceAfterBattle {
    "What the law does not specify, I\n"
    "will reveal through practice."
}

text PenanceAfterBattle_Win {
    "I am fighting for more than just the\n"
    "law. Also the justice and virtue\l"
    "that extend beyond it. The law is\l"
    "a means, not an end."
}

text PenanceAfterBattle_Lose {
    "Even a crime-ridden swamp is not\n"
    "beyond salvation. Thank you\l"
    "for reminding me of this fact."
}

script AKGreen_Pramanix {
    setspeaker(SP_NAME_PRAMANIX)
    msgbox(PramanixBeforeBattle)
    trainerbattle_no_intro(TRAINER_PRAMANIX, PramanixAfterBattle)
    // msgbox("Good battle!")
    closemessage
    setspeaker(SP_NAME_PRAMANIX)
    switch(var(VAR_RESULT)){
        default:
            msgbox(PramanixAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(PramanixAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text PramanixBeforeBattle {
    "Wasting time on trivial affairs is\n"
    "what I call slacking off. What I'm\l"
    "doing right now is…\p"
    "Taking the opportunity to recharge."
}

text PramanixAfterBattle {
    "Work hard, play hard, right? Don't\n"
    "force all those rigid rules on me."
}

text PramanixAfterBattle_Win {
    "You have my blessings on the path\n"
    "ahead."
}

text PramanixAfterBattle_Lose {
    "These powers are a gift from the\n"
    "Holy Mountain. It was simple,\l"
    "thanks to the Spirits' power."
}

script AKGreen_Fiametta {
    setspeaker(SP_NAME_FIAMETTA)
    msgbox(FiamettaBeforeBattle)
    trainerbattle_no_intro(TRAINER_FIAMETTA, FiamettaAfterBattle)
    // msgbox("Good battle!")
    closemessage
    setspeaker(SP_NAME_FIAMETTA)
    switch(var(VAR_RESULT)){
        default:
            msgbox(FiamettaAfterBattle_Lose)
            goto(Gauntlet_BattleLost)
        case 1:
            msgbox(FiamettaAfterBattle_Win)
            call(Gauntlet_BattleWon)
    }
    return
}

text FiamettaBeforeBattle {
    "I tried using guns before, but it\n"
    "didn't pan out, so I gave up.\p"
    "What, are you surprised? Guns aren't\n"
    "some huge mystery, but they need\l"
    "practice."
}

text FiamettaAfterBattle {
    "There's no fluking between success\n"
    "and failure."
}

text FiamettaAfterBattle_Win {
    "Can people really cut everything\n"
    "loose without looking back, even\l"
    "shatter the order that was there,\l"
    "all to chase ideals?\p"
    "Y'know what… maybe they can."
}

text FiamettaAfterBattle_Lose {
    "Sorry, forgot to hold back. Better\n"
    "luck next time."
}

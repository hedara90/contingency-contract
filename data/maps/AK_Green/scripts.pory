mapscripts AK_Green_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: AKGreen_OnTransition
    MAP_SCRIPT_ON_WARP_INTO_MAP_TABLE [
        VAR_TEMP_5, 0: AKGreen_Setup
    ]
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_5, 0: AKGreen_OnGauntletStart
    ]
}

const player = OBJ_EVENT_ID_PLAYER
const tiana = LOCALID_TIANA

script AKGreen_OnTransition {
    if(var(VAR_GAUNTLET_POSITION)==0){
        setobjectxyperm(tiana, 10, 11)
    }
}

script AKGreen_Setup {
    hideobjectat(player, MAP_AK_GREEN)
}

script AKGreen_OnGauntletStart {
    setvar(VAR_TEMP_5, 1)
    call(Gauntlet_SetupCamera)
    goto(AKGreen_StartBattle)
}

script AKGreen_StartBattle {
    switch(var(VAR_GAUNTLET_POSITION)) {
        case 0: 
            call(Gauntlet_OpponentMovement_BeforeBattle)
            call(AKGreen_Carnelian)
            call(Gauntlet_PostBattle)
            goto(AKGreen_StartBattle)
        case 1:
            call(Gauntlet_OpponentMovement_BeforeBattle)
            call(Gauntlet_MovePlayerBeforeBattle)
            call(AKGreen_Penance)
            call(Gauntlet_PostBattle)
            goto(AKGreen_StartBattle)
        case 2:
            call(Gauntlet_OpponentMovement_BeforeBattle)
            call(Gauntlet_MovePlayerBeforeBattle)
            call(AKGreen_Pramanix)
            call(Gauntlet_PostBattle)
            goto(AKGreen_StartBattle)
        case 3:
            call(Gauntlet_OpponentMovement_BeforeBattle)
            call(Gauntlet_MovePlayerBeforeBattle)
            call(AKGreen_Fiametta)
            call(Gauntlet_PostBattle)
    }
}

script AKGreen_Carnelian {
    msgbox(CarnelianBeforeBattle)
    trainerbattle_no_intro(TRAINER_CARNELIAN, CarnelianAfterBattle)
    // msgbox("Good battle!")
    closemessage
    switch(var(VAR_RESULT)){
        default:
            msgbox(CarnelianAfterBattle_Lose)
        case 1:
            msgbox(CarnelianAfterBattle_Win)
    }
    return
}

text CarnelianBeforeBattle {
    "Hello"
}

text CarnelianAfterBattle {
    ""
}

text CarnelianAfterBattle_Win {
    ""
}

text CarnelianAfterBattle_Lose {
    ""
}

